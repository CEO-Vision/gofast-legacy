  $translations['nl:default']['2b1985e8439b073796783c76c7e3a504'] = array(
    'source' => 'The granularity is the smallest unit to use when determining whether two dates are the same; for example, if the granularity is "Year" then all dates in 1999, regardless of when they fall in 1999, will be considered the same date.',
