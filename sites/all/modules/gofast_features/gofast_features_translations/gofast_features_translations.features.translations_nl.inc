  $translations['nl:default']['061031713a72f1ae7cd750532cc42f6e'] = array(
    'source' => 'The Aggregator module is an on-site syndicator and news reader that gathers and displays fresh content from RSS-, RDF-, and Atom-based feeds made available across the web. Thousands of sites (particularly news sites and blogs) publish their latest headlines in feeds, using a number of standardized XML-based formats. For more information, see the online handbook entry for <a href="@aggregator-module">Aggregator module</a>.',
    'context' => '',
    'location' => '',
    'translation' => 'De Aggregator-module is een nieuwsverzamelaar en -lezer die informatie betrekt van websites met RSS, RDF en/of Atom-feeds. Veel websites (met name nieuwssites en blogs) publiceren hun laatste berichten met behulp van feeds. Hiervoor worden een aantal gestandaardiseerde XML-formaten gebruikt. Lees voor meer informatie de <a href="@aggregator-module">Aggregator-module documentatie</a>.',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('The Aggregator module is an on-site syndicator and news reader that gathers and displays fresh content from RSS-, RDF-, and Atom-based feeds made available across the web. Thousands of sites (particularly news sites and blogs) publish their latest headlines in feeds, using a number of standardized XML-based formats. For more information, see the online handbook entry for <a href="@aggregator-module">Aggregator module</a>.', array(), array('context' => ''));
