  $translations['nl:default']['2d911f6b57231f02c41fd98774447c91'] = array(
    'source' => '<strong>Important!</strong> When adding, removing, or renaming template files, it is necessary to make Drupal aware of the changes by making it rescan the files on your system. By clicking this button you clear Drupal\'s theme registry and thereby trigger this rescanning process. The highlighted templates above will then reflect the new state of your system.',
    'context' => '',
    'location' => '',
    'translation' => '<strong>Belangrijk!</strong> Na het toevoegen, verwijderen of hernoemen van template-bestanden is het noodzakelijk dat Drupal op de hoogte wordt gebracht van de wijzigingen, door de bestanden op de server opnieuw te scannen. Door middel van deze knop wordt het themaregister van Drupal geleegd en het scannen opnieuw uitgevoerd. Daarna geven de vetgedrukte templates hierboven de nieuwe situatie aan.',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('<strong>Important!</strong> When adding, removing, or renaming template files, it is necessary to make Drupal aware of the changes by making it rescan the files on your system. By clicking this button you clear Drupal\'s theme registry and thereby trigger this rescanning process. The highlighted templates above will then reflect the new state of your system.', array(), array('context' => ''));
