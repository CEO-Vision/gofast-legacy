  $translations['nl:default']['6624467c39a71b6fc5a6d48f6057121a'] = array(
    'source' => 'When providing a menu item as a tab, Drupal needs to know what the parent menu item of that tab will be. Sometimes the parent will already exist, but other times you will need to have one created. The path of a parent item will always be the same path with the last part left off. i.e, if the path to this view is <em>foo/bar/baz</em>, the parent path would be <em>foo/bar</em>.',
    'context' => '',
    'location' => '',
    'translation' => 'Indien een menu-item als tab wordt gedefinieerd, moet Drupal weten wat het bovenliggende menu-item van de tab is. Mogelijk bestaat dat bovenliggende menu-item al, zo niet dan moet het worden aangemaakt. Het pad van een bovenliggend item zal altijd hetzelfde zijn als dat van het item zelf, zonder het laatste deel. Als het pad naar dit overzicht bijvoorbeeld <em>foo/bar/baz</em> is, zal het pad van het bovenliggende item <em>foo/bar</em> zijn.',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('When providing a menu item as a tab, Drupal needs to know what the parent menu item of that tab will be. Sometimes the parent will already exist, but other times you will need to have one created. The path of a parent item will always be the same path with the last part left off. i.e, if the path to this view is <em>foo/bar/baz</em>, the parent path would be <em>foo/bar</em>.', array(), array('context' => ''));
