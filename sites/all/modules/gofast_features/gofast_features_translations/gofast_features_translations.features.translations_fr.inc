  $translations['fr:default']['8ab8b6e30c6bdedf3e45297423d95e30'] = array(
    'source' => 'The module includes a <em>Popular content</em> block that displays the most viewed pages today and for all time, and the last content viewed. To use the block, enable <em>Count content views</em> on the <a href="@statistics-settings">statistics settings page</a>, and then you can enable and configure the block on the <a href="@blocks">blocks administration page</a>.',
