  $translations['fr:default']['07b4816690b630f23e9fe53d0eecb46e'] = array(
    'source' => 'The Book module is used for creating structured, multi-page content, such as site resource guides, manuals, and wikis. It allows you to create content that has chapters, sections, subsections, or any similarly-tiered structure. For more information, see the online handbook entry for <a href="@book">Book module</a>.',
