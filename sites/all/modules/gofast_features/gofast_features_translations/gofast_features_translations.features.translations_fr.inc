  $translations['fr:default']['77a042eeabe4727e864aaefe7d28918a'] = array(
    'source' => 'The URL path to get to this page. You may create named placeholders for variable parts of the path by using %name for required elements and !name for optional elements. For example: "node/%node/foo", "forum/%forum" or "dashboard/!input". These named placeholders can be turned into contexts on the arguments form.',
