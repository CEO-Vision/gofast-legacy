  $translations['fr:default']['dc8e967153c494dcf115fcc1f06dd282'] = array(
    'source' => 'The Color module saves a modified copy of the theme\'s specified stylesheets in the files directory. This means that if you make any manual changes to your theme\'s stylesheet, <em>you must save your color settings again, even if they haven\'t changed</em>. This step is required because the module stylesheets (in the files directory) need to be recreated to include your changes.',
