  $translations['fr:default']['aafda4686dd838118cb791a483e363ea'] = array(
    'source' => 'If enabled, some fields may become unavailable. All fields that are selected for grouping will be collapsed to one record per distinct value. Other fields which are selected for aggregation will have the function run on them. For example, you can group nodes on title and count the number of nids in order to get a list of duplicate titles.',
