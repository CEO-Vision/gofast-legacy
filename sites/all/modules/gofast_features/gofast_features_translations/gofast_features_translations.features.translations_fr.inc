  $translations['fr:default']['ce1859d3e1d3322a52ae40de11dea75f'] = array(
    'source' => 'This filter can cause items that have more than one of the selected options to appear as duplicate results. If this filter causes duplicate results to occur, this checkbox can reduce those duplicates; however, the more terms it has to search for, the less performant the query will be, so use this with caution. Shouldn\'t be set on single-value fields, as it may cause values to disappear from display, if used on an incompatible field.',
    'context' => '',
    'location' => '',
    'translation' => 'Ce filtre peut faire apparaître des éléments comme des doublons s\'ils ont plus d\'une option sélectionnée. Si ce filtre engendre des doublons, cette case peut les réduire&nbsp;; cependant, plus il y aura de termes de recherche, moins la requête sera performante, donc utilisez ceci avec précaution. Cela ne devrait pas être actif sur des champs à valeur unique, car cela pourrait faire disparaître des valeurs de l\'affichage si c\'est utilisé sur un champ incompatible.',
    'plid' => 0,
    'plural' => 0,
  );
