  $translations['fr:default']['0a55a05c1e4a094060a129f4457bd71c'] = array(
    'source' => '<strong>Use this option with care.</strong> If checked, CKEditor will allow anyone knowing the URL to view a file located inside of the private path (!private_path), but only if there is no information about the file in the Drupal database. If the path below is specified, anyone will have access only to that location.',
