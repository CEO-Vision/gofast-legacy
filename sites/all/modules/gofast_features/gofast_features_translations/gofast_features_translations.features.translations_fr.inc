  $translations['fr:default']['80ab57d7bc5bb60de1375900dd484dd4'] = array(
    'source' => '<p>The following substitution patterns are available for this display. Use the pattern shown on the left to display the value indicated on the right. Note that due to rendering order, you cannot use fields that come after this field; if you need a field not listed here, rearrange your fields.</p>',
    'context' => '',
    'location' => '',
    'translation' => '<p>Les motifs de remplacement suivants sont disponibles pour cet affichage. Utilisez les motifs affichés à gauche pour afficher la valeur indiquée à droite. Notez qu\'à cause de l\'ordre de traitement du rendu, vous ne pouvez pas utiliser les champs qui arrivent après celui-ci&nbsp; si vous avez besoin d\'un champ non listé ici, ré-arrangez l\'ordre de vos champs.</p>',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('<p>The following substitution patterns are available for this display. Use the pattern shown on the left to display the value indicated on the right. Note that due to rendering order, you cannot use fields that come after this field; if you need a field not listed here, rearrange your fields.</p>', array(), array('context' => ''));
