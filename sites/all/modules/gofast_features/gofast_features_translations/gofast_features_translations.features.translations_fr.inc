  $translations['fr:default']['6b111fc952adad5b46c7f67640be88a8'] = array(
    'source' => 'Content subscriptions are subscriptions to nodes that will produce notifications when a node is posted or updated or when a comment is posted for that nodes. Notifications will be sent only for published content so if you need to be notified of unpublished content waiting for approval you better use Triggers and Actions or some other module for that.',
    'context' => '',
    'location' => '',
    'translation' => 'Les abonnements aux contenus sont des abonnements aux nœuds qui déclencheront des notifications lorsqu\'un nœud est posté ou mis à jour, ou bien lorsqu\'un commentaire est posté pour ces nœuds. Les notifications seront seulement envoyées pour le contenu publié, aussi si vous avez besoin d\'être prévenus pour des contenus non publiés qui attendent une approbation, vous feriez mieux d\'utiliser les Déclencheurs et les Actions (Triggers and Actions) ou d\'autres modules à cet effet.',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('Content subscriptions are subscriptions to nodes that will produce notifications when a node is posted or updated or when a comment is posted for that nodes. Notifications will be sent only for published content so if you need to be notified of unpublished content waiting for approval you better use Triggers and Actions or some other module for that.', array(), array('context' => ''));
