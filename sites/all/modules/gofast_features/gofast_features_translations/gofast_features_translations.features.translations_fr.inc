  $translations['fr:default']['2d911f6b57231f02c41fd98774447c91'] = array(
    'source' => '<strong>Important!</strong> When adding, removing, or renaming template files, it is necessary to make Drupal aware of the changes by making it rescan the files on your system. By clicking this button you clear Drupal\'s theme registry and thereby trigger this rescanning process. The highlighted templates above will then reflect the new state of your system.',
