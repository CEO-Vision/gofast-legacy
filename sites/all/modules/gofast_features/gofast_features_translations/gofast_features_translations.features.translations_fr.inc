    'location' => '',
    'translation' => 'Les champs des termes de taxonomie sont définis au niveau du vocabulaire, dans l\'onglet <em>Gérer les champs</em> de la page de modification du vocabulaire (à laquelle vous pouvez accéder depuis la page <a href="@taxonomy"><em>Taxonomie</em></a>). Lorsque vous définissez un champ pour un vocabulaire, chaque terme du vocabulaire disposera de ce champ. Vous pouvez par exemple définir un champ image pour un vocabulaire de manière à stocker une icone pour chaque terme.',
    'plid' => 0,
    'plural' => 0,
  );
  $translatables[] = t('Fields on taxonomy terms are defined at the taxonomy vocabulary level, on the <em>Manage fields</em> tab of the vocabulary edit page (which you can reach from the <a href="@taxonomy">Taxonomy page</a>). When you define a field for a vocabulary, each term in that vocabulary will have that field added to it. For example, you could define an image field for a vocabulary to store an icon with each term.', array(), array('context' => ''));
