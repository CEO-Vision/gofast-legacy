  $translations['fr:default']['f6a3c73b61d28a6cb990bea0042b5385'] = array(
    'source' => 'Components are stand-alone sets of Rules configuration that can be used by Rules and other modules on your site. Components are for example useful if you want to use the same conditions, actions or rules in multiple places, or call them from your custom module. You may also export each component separately. See <a href="@url">the online documentation</a> for more information about how to use components.',
