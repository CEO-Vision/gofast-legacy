/**
 * Implements hook_cronapi().
 */
function gofast_search_advanced_cronapi($op, $job = NULL): array {
  $items['gofast_search_advanced_cleanup_export_files_cron'] = array(
    'description' => 'Remove all generated export files',
    'rule' => '15 23 * * 0', // Each Sunday at 23:15
  );
  return $items;
}

/**
 * Implementation of hook_apachesolr_query_alter().
 *
 * @param DrupalSolrQueryInterface $query
 * @see apachesolr.interface.inc
 */
function gofast_search_advanced_apachesolr_query_alter(DrupalSolrQueryInterface $query) {
  // If $_POST ou $_GET['globalOperator'] == "OR" then we need to add a subquery
  if ($_POST['globalOperator'] === "OR" || $_GET['globalOperator'] === "OR") {
    
    $fqFilters = $query->getParams()['fq'];
    array_pop($fqFilters); // Remove node access fq (last element of the array)
    // If only one filter, we don't need to add a subquery
    if (count($fqFilters) > 1) {

    // Create new solr subquery
    $filtersSubQuery = new SolrFilterSubQuery('OR');

    foreach ($fqFilters as $fqFilter) {
      // Get key : value
      [$fieldName, $fieldValue] = explode(':', $fqFilter, 2);
      
      // Remove the - from the field name if exist
      if (substr($fieldName, 0, 1) === '-') {
        $fieldName = substr($fieldName, 1);
      }

      $filtersSubQuery->addFilter($fieldName, $fieldValue, FALSE);
      $query->removeFilter($fieldName);
    }
    // Add the subquery to the main query
    $query->addFilterSubQuery($filtersSubQuery); 
    }
  }
  
  // Get the sort parameters from the url
  if(isset($_GET['sort'])){
    $sort_field = $_GET['sort']['field'];
    
    // Handling the case where the sort field is a the title
    if($sort_field == "label"){
      $sort_field = "sort_label";
    }
    
    $sort_sort = $_GET['sort']['sort'];
    $query->setAvailableSort($sort_field, array('title' => $sort_field, 'default' => 'asc'));
    $query->setSolrsort($sort_field, $sort_sort);
  }
  // Get the pagination parameters from the url and what page we are on
  if(isset($_GET['pagination'])){
    $pagination = $_GET['pagination'];
    $query->replaceParam('rows', $pagination["perpage"]);
    $query->replaceParam('start', ($pagination["page"] - 1) * $pagination["perpage"]);
  }
}

/**
 * Implementation of hook_declare_metadatas().
 */
function gofast_search_advanced_declare_all_metadatas($only_metadata = true, $include_standard_metadata = true){
  $all_metadatas = array();
  // Get standard metadatas first if necessary
  if($include_standard_metadata){
    $standard_metadatas = gofast_search_advanced_declare_standard_metadatas();
    if($only_metadata){
      $all_metadatas = $standard_metadatas['metadatas'];
    }else{
      $all_metadatas[$standard_metadatas['name']] = $standard_metadatas['metadatas'];
    }
  }
  
  // use module_implements to get all metadatas declare in specific hook
  $hook_name = 'declare_metadatas';
  $modules = module_implements($hook_name);
  foreach ($modules as $module) {
    $function = $module . '_' . $hook_name;
    if (function_exists($function)) {
      $result = $function();
      if (isset($result)) {
        if($only_metadata){
          // reach $result['metadatas'] and and check if each metadata have a 'solr_field' key
          foreach($result['metadatas'] as $key => $metadata){
            if(!isset($metadata['solr_field']) || $metadata['prevent_index']){
              unset($result['metadatas'][$key]);
            }
          }
          $all_metadatas = array_merge($all_metadatas, $result['metadatas']);
        }else{
          $all_metadatas[$result['name']] = $result['metadatas'];
        }
      }
    }
  }
  return $all_metadatas;
}

/**
 * Call custom hook to modify the result
 */
function gofast_search_advanced_advanced_search_result_alter($result){
  global $user;
  // For each result, we need to format all the fields
  // Here is the standard part

  // If we want to export, we don't need same format for some fields
  $is_export = false;
  if(isset($_GET["export"]) && $_GET["export"] == true){
    $is_export = true;
  }

  // Change creation date and changed date into a date format
  $changed_date = new DateTime($result['ds_changed']);
  $result['ds_changed'] = $changed_date->format('d/m/Y H:i:s');

  $created_date = new DateTime($result['ds_created']);
  $result['ds_created'] = $created_date->format('d/m/Y H:i:s');

  $custom_date = new DateTime($result['ds_custom_date']);
  $result['ds_custom_date'] = $custom_date->format('d/m/Y H:i:s');

  if($result['ds_field_date'] != "1970-01-01T00:00:00Z"){
    $field_date = new DateTime($result['ds_field_date']);
    $result['ds_field_date'] = $field_date->format('d/m/Y H:i:s');
  }else{
    $result['ds_field_date'] = "-";
  }

  // If there is no criticity, we don't display the field
  if(!empty($result['im_field_criticity'])){
    $term_criticity = taxonomy_term_load($result['im_field_criticity'][0]);
    // Load and translate all terms at once.
    $result['im_field_criticity'] = i18n_object('taxonomy_term', $term_criticity)->localize($user->language)->name;
  }

  if(!empty($result['im_field_classification'])){
    $term_classification = taxonomy_term_load($result['im_field_classification'][0]);
    // Load and translate all terms at once.
    $result['im_field_classification'] = i18n_object('taxonomy_term', $term_classification)->localize($user->language)->name;
  }

  if(!empty($result['sm_vid_Category'])){
    // Categories are retrieved as the term names.
    foreach ($result['sm_vid_Category'] as $k => $term_name) {
      // Get one term matching the name. There may be multiple (e.g.: document
      // category and space category of same name), in that case we keep only
      // the one that matches the current result bundle's category type.
      $term_category = taxonomy_get_term_by_name($term_name, taxonomy_vocabulary_load(GOFAST_VID_CATEGORY)->machine_name);
      $term_category = reset($term_category);

      // Localize category term.
      $localized_category = i18n_taxonomy_localize_terms($term_category);
      // Update result with localized name.
      $result['sm_vid_Category'][$k] = $localized_category->name;
    }
  }

  if(!empty($result['im_field_state'])){
    // Load and translate all terms at once.
    $term_state = taxonomy_term_load($result['im_field_state'][0]);
    $result['im_field_state'] = i18n_object('taxonomy_term', $term_state)->localize($user->language)->name;
  }

  if(!empty($result['im_field_tags'])){
    foreach($result['im_field_tags'] as $key => $value){
      $term_tag = taxonomy_term_load($value);
      $term_tag_name = $term_tag->name;
      $result['im_field_tags'][$key] = array();
      $result['im_field_tags'][$key]['label'] = $term_tag_name;
    }
    $result["im_field_tags"] = gofast_search_advanced_format_tag_search_result($result["im_field_tags"]);
  }

  if(!empty($result["formatedGroupes"]) && count($result["formatedGroupes"]) > TAGS_DISPLAY_AMOUNT){
    $spaces_gids = array_map(function($space){
      return $space["nid"];
    }, $result["formatedGroupes"]);
    if(!$is_export){
      array_splice($result["formatedGroupes"], TAGS_DISPLAY_AMOUNT);
      $result["formatedGroupes"]["more"] = gofast_get_show_more_space_template($spaces_gids);
    }
  }
  
  if(!$is_export){
    // Change language into flag
    $result['ss_language'] = gofast_get_flag_icon($result['ss_language']);
    // Change the label name into node link
    $result['label'] = l($result['label'], $result['entity_type'] . "/" . $result['entity_id'], array('attributes' => array('class' => 'text-truncate', 'target' => '_blank', 'title' => $result["label"])));
    $author = user_load($result['is_uid']);
    $result['tos_name'] = theme('user_picture', array('account' => $author, 'popup' => FALSE, 'dimensions' => '30'));
    $last_modifier = user_load($result['is_mod_uid']);
    $result['tos_mod_name'] = theme('user_picture', array('account' => $last_modifier, 'popup' => FALSE, 'dimensions' => '30'));
    $term = taxonomy_term_load($result['im_field_format'][0]);
    $icon = gofast_utils_transform_to_fa5_icone($term->field_icone[LANGUAGE_NONE][0]['value']);
    $result['im_field_format'] = '<i class="fa-2x ' . $icon . '"></i>';
  } else {
    $tid = $result['im_field_format'][0];
    $result['im_field_format'] = i18n_object('taxonomy_term', taxonomy_term_load($tid))->localize($user->language)->name;
    $result["tos_name"] = gofast_user_display_name(user_load($result["is_uid"]));
    $result["tos_mod_name"] = gofast_user_display_name(user_load($result["is_mod_uid"]));
    $result['ss_language'] = $result['ss_language'] == "und" ? "-" : $result["ss_language"];
  }

  return $result;
}

/**
 * template_preprocess_gofast_search_advanced_history
 */
function template_preprocess_gofast_search_advanced_history(&$variables){

  global $user;
  $columns = [];

  $columns['name'] = t('Nom', array(), array('context' => 'gofast:gofast_directory'));
  $columns['date'] = t('Date', array(), array('context' => 'gofast:gofast_directory'));

  $jsonColumns = json_encode($columns);

  $variables['columns'] = $jsonColumns;
}

/**
 * template_preprocess_gofast_search_advanced_form
 */
function template_preprocess_gofast_search_advanced_form(&$variables){

  global $user;

  $filters = gofast_search_advanced_get_search_advanced_filters();

  $variables['fieldsets'] = $filters;
}


/**
 * template_preprocess_page_gofast_search_advanced_search
 */
function template_preprocess_page_gofast_search_advanced_search(&$variables) {
  
  $array_actions[]['themed'] = theme('gofast_link_generic', array(
    'icon_class' => "fas fa-trash text-danger",
    'href' => "/modal/nojs/search/advanced/history/clear/confirm",
    'link_class' => 'ctools-use-modal',
    'text' => t("Delete all history", array(), array('context' => 'gofast:gofast_search_advanced')),
  ));

  $array_actions[]['themed'] = theme('gofast_link_generic', array(
    'icon_class' => "fas fa-trash text-danger",
    'href' => "",
    'link_class' => 'delete-selected-items',
    'text' => t("Delete selection", array(), array('context' => 'gofast:gofast_search_advanced')),
    'disabled' => TRUE
  ));

  $user_contextual_actions[] = array(
    'id' => 'account-dropdown',
    'title' => 'Contextual actions',
    'button-text' => '',
    'icon-class' => 'fa fa-bars',
    'children' => $array_actions
  );

  $variables['contextual_menu'] = theme('contextual_links', array('buttons' => $user_contextual_actions));
}
