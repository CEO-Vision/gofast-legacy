<?php
/**
 * Load necessary functions.
 */

module_load_include('inc', 'gofast_onlyoffice', 'gofast_onlyoffice_functions');
module_load_include('inc', 'gofast_onlyoffice', 'gofast_onlyoffice_forms');
require_once(DRUPAL_ROOT .'/sites/all/libraries/firebase-jwt/vendor/autoload.php');
use Firebase\JWT\JWT;

/**
 * Define the path pointing to alfresco server
 */
global $base_url;
define('GOFAST_URL_WEBSCRIPT_ALFRESCO', $base_url.'/alfresco/s/');
define('GOFAST_URL_ONLYOFFICE_CALLBACK', $base_url.'/');
define('GOFAST_ONLYOFFICE_SOFT_LOCK', 'field_onlyoffice_lock');
// Longest end of session save an editor opening waits for, in seconds
define('GOFAST_ONLYOFFICE_SAVING_TIMEOUT', 30);
// Delay kept after the save: OnlyOffice cleans the session up after the callback response, in seconds
define('GOFAST_ONLYOFFICE_SAVING_GRACE', 5);

/**
 * Implements hook_library().
 */
function gofast_onlyoffice_library(){
  $path = drupal_get_path('module', 'gofast_onlyoffice');
  $libraries['gofast_onlyoffice_convert'] = array(
    'title' => 'GoFAST OnlyOffice JS handlers for convert service',
    'version' => '1.0',
    'js' => array(
      $path . '/js/gofast_onlyoffice_convert.js' => array(
        'group' => JS_THEME,
        'every_page' => TRUE,
        'weight' => 1
      )
    ),
  );
  return $libraries;
}

/**
* Implements hook_init().
*/
function gofast_onlyoffice_init()
{
  drupal_add_library("gofast_onlyoffice", "gofast_onlyoffice_convert", TRUE);
}

/**
 * Hook theme
 * @return type
 */
function gofast_onlyoffice_theme() {

  return array(
    'onlyoffice' => array(
      'template' => 'tpl/gofast_onlyoffice',
      'variables' => array(
        'nid' => NULL,
        'fileuri' => NULL,
        'filename' => NULL,
        'callbackUrl' => NULL,
        'user' => NULL,
        'permission' => NULL,
        'timestamp' => NULL,
        'key' => NULL,
        'editor_mode' => NULL,
        'edit_permission' => NULL,
        'extension' => NULL
      )
    ),
    'onlyoffice_ro' => array(
      'template' => 'tpl/gofast_onlyoffice_ro',
      'variables' => array(
        'nid' => NULL,
        'fileuri' => NULL,
        'filename' => NULL,
        'callbackUrl' => NULL,
        'user' => NULL,
        'permission' => NULL,
        'timestamp' => NULL,
        'key' => NULL,
        'editor_mode' => NULL,
        'edit_permission' => NULL,
        'extension' => NULL
      )
      ),
      'onlyoffice_compare' => array(
        'template' => 'tpl/gofast_onlyoffice_compare',
      ),
      'onlyoffice_convert_progress' => array(
        'template' => 'tpl/gofast_onlyoffice_convert_progress',
      ),
  );
}

/**
 * Hook menu
 * @return type
 */
function gofast_onlyoffice_menu() {
  $items = array();

  $items['onlyoffice/editor/%node'] = array(
    'title' => 'Onlyoffice document editor',
    'page callback' => 'gofast_onlyoffice_render_editor',
    'type' => MENU_CALLBACK,
    'page arguments' => array(2),
    'access arguments' => array('view', 2),
    'access callback' => 'node_access',
  );

  $items['onlyoffice/config/%node'] = array(
    'title' => 'Onlyoffice document configuration',
    'page callback' => 'gofast_onlyoffice_get_config_ajax',
    'type' => MENU_CALLBACK,
    'page arguments' => array(2),
    'access arguments' => array('access content'),
    'access callback' => 'user_access',
    'delivery callback' => 'gofast_ajax_delivery',
  );

  $items['onlyoffice/callback/%/%/%'] = array(
    'title' => 'Process onlyoffice callback and dispatch to alfresco',
    'page callback' => 'gofast_onlyoffice_callback',
    'type' => MENU_CALLBACK,
    'page arguments' => array(2,3,4),
    'access callback' => true,
    'delivery callback' => 'gofast_ajax_delivery',
  );

  $items['onlyoffice/config/jwt'] = array(
    'title' => 'Onlyoffice document configuration JWT signature',
    'page callback' => 'gofast_onlyoffice_sign_config_ajax',
    'type' => MENU_CALLBACK,
    'access arguments' => array('access content'),
    'access callback' => 'user_access',
    'delivery callback' => 'gofast_ajax_delivery',
  );

  $items['modal/%ctools_js/convert/onlyoffice/%node'] = array(
    'title' => 'Display modal for conversion using OnlyOffice',
    'page callback' => 'gofast_onlyoffice_convert_modal',
    'type' => MENU_CALLBACK,
    'page arguments' => array(1, 4),
    'access arguments' => array('access content'),
    'access callback' => 'user_access',
    'delivery callback' => 'gofast_ajax_delivery',
  );

  return $items;
}

function template_preprocess_onlyoffice_compare(&$variables) {
  global $conf;

  $node = $variables["node"];
  $version_source = $variables["version_source"];
  $version_dest = $variables["version_dest"];
  $reference = gofast_cmis_node_get_item_id($node);
  [$version_source_uuid, $version_dest_uuid] = gofast_pdf_compare_get_versions_links($reference, $version_source, $version_dest, TRUE);

  // inject versions links into the OO compare template to trigger OO comparison on the correct targets
  $alfresco_ticket = gofast_cmis_ticket_validate(); // This ticket is used for the Alfresco's authentification
  $variables["version_source_link"] = rtrim(GOFAST_URL_WEBSCRIPT_ALFRESCO, '/') . '/api/node/content/versionStore/version2Store/' . $version_source_uuid . '?alf_ticket=' . $alfresco_ticket;
  $variables["version_dest_link"] = rtrim(GOFAST_URL_WEBSCRIPT_ALFRESCO, '/') . '/api/node/content/versionStore/version2Store/' . $version_dest_uuid . '?alf_ticket=' . $alfresco_ticket;

  // if we have pdf, we must change the extension to docx and convert both source and dest files to docx otherwise OO will not be able to compare the files
  if ($variables["extension"] == "pdf") {
    if (str_ends_with($node->title, ".pdf")) {
      $node->title = rtrim($node->title, ".pdf") . ".docx";
    }
    $variables["extension"] = "docx";
    $source_link = gofast_cmis_convert_document($node, $variables["version_source_link"], "docx");
    $variables["version_source_link"] = json_decode(json_encode($source_link))->FileUrl;
    $dest_link = gofast_cmis_convert_document($node, $variables["version_dest_link"], "docx");
    $variables["version_dest_link"] = json_decode(json_encode($dest_link))->FileUrl;
  }

  // if there is any error, it will be shown in the template instead of the OO iframe
  $variables["errors"] = [];
  if (!$variables["version_source_link"] || !$variables["version_dest_link"]) {
    $variables["errors"][] = t("Could not convert the document for comparison", [], ["context" => "gofast:gofast_onlyoffice"]);
  }

  // tokenize configuration for docsApi
  $doc_config = gofast_onlyoffice_get_config($node, gofast_generate_uuid(), $variables["version_source_link"], "compare");
  $variables["token"] = JWT::encode($doc_config, $conf['oo_jwt_secret'], "HS256");
  $variables["docConfig"] = json_encode($doc_config, JSON_HEX_APOS);
  // tokenize configuration for compare OO command
  $doc_request_config = [
    "c" => "compare",
    "filetype" => $variables["extension"],
    "url" => $variables["version_dest_link"],
  ];
  $variables["docRequestToken"] = JWT::encode($doc_request_config, $conf['oo_jwt_secret'], "HS256");
  $variables["docRequestConfig"] = json_encode($doc_request_config);
}

function gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload) {
  global $conf;

  $url_attributes['nodeRef'] = $complete_node_ref;
  $url_attributes['cb_key'] = $hash;
  $alfresco_callback_url = urldecode('http://localhost:8080/alfresco/s' . '/parashift/onlyoffice/callback?' . http_build_query($url_attributes));

  $token =  JWT::encode($payload, $conf['oo_jwt_secret'], "HS256");
  //Dispatching data to alfresco
  $ch = curl_init($alfresco_callback_url);
  curl_setopt($ch, CURLOPT_CUSTOMREQUEST, "POST");
  curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode(["token" => $token]));
  curl_setopt($ch, CURLOPT_RETURNTRANSFER, TRUE);
  curl_setopt($ch, CURLOPT_USERPWD, 'admin:' . gofast_get_admin_pwd());
  curl_setopt($ch, CURLOPT_HTTPHEADER, array('Content-Type: application/json'));
  curl_setopt($ch, CURLOPT_TIMEOUT, 15);
  $result = curl_exec($ch);
  return $result;
}

/**
 * Get the OnlyOffice document key given an alfresco reference or raw item ID
 * @param string $alfresco_reference The alfresco reference (or raw item id) to get the document key of
 * @return false|string Document key string on success, false on failure (e.g.: document not being edited)
 */
function gofast_onlyoffice_get_document_key_by_alfresco_reference($alfresco_reference) {
  if (empty($alfresco_reference)) {
    return FALSE;
  }
  $item_id = gofast_cmis_get_raw_item_id($alfresco_reference);
  $hash = gofast_onlyoffice_get_document_key($alfresco_reference);
  if (empty($hash)) {
    return FALSE;
  }
  return "{$item_id}_{$hash}";
}

/**
 * Get the OnlyOffice document key given a loaded node
 * @param mixed $node Loaded node of document to get the document key of
 * @return false|string Document key string on success, false on failure (e.g.: document not being edited)
 */
function gofast_onlyoffice_get_document_key_by_node($node) {
  $alfresco_reference = gofast_cmis_node_get_item_id($node);
  return gofast_onlyoffice_get_document_key_by_alfresco_reference($alfresco_reference);
}

/**
 * Retrieves the list of usernames of users co-editing a node's document.
 * @param object $node The fully loaded node of the document.
 */
function gofast_onlyoffice_get_users_editing_by_node($node) {
  $onlyoffice_document_key = gofast_onlyoffice_get_document_key_by_node($node);
  return gofast_onlyoffice_get_users_editing($onlyoffice_document_key);
}

/**
 * Retrieves the list of usernames of users co-editing a document with the given key.
 * @param string $document_key The Onlyoffice document key/identifier of which to get the users co-editing.
 */
function gofast_onlyoffice_get_users_editing($document_key) {
  $users_cache_key = gofast_onlyoffice_get_document_users_cache_key($document_key);
  $users = cache_get($users_cache_key);
  if ($users !== FALSE) {
    return $users->data ?? [];
  }

  // force refresh
  // info command will lead to call to the gofast_onlyoffice_callback function below with a status of 1.
  // The callback will then set the cache to the value we want to retrieve.
  $result = gofast_onlyoffice_api_query_info_command($document_key);
  if ($result->error !== 0) {
    watchdog(
      'gofast_onlyoffice',
      "query to onlyoffice's command service returned with error code '$result->error'",
      [],
      WATCHDOG_ERROR,
    );
    return [];
  }

  // poll the cache retrying with a sort of exponential backoff
  // currently polls 10 times over a total of 1+2+4+7*5 = 42 seconds
  $retries = 0;
  $max_retries = 10;
  // delays to sleep for in seconds
  $retry_delay = 1;
  $retry_max_delay = 5;
  // how fast the delay grows after each retry
  $retry_delay_multiplier = 2;
  do {
    $users = cache_get($users_cache_key);

    if ($users !== FALSE) {
      break;
    }

    $retries++;
    $current_delay = $retry_delay;
    $retry_delay = min($retry_delay * $retry_delay_multiplier, $retry_max_delay);
  } while ($retries < $max_retries && sleep($current_delay) === 0);

  // Failed to load users even after polling the cache (or failed to sleep in-between polls)
  if ($users === FALSE) {
    return [];
  }

  return $users->data ?? [];
}

/**
 * Get the cache key of A document's co-editing user list, to get it using `cache_get`
 * @param string $document_key The OnlyOffice document's key/identifier
 * @return string The document users' cache key
 */
function gofast_onlyoffice_get_document_users_cache_key($document_key) {
  return "OODocument:" . $document_key . ':users';
}

/**
 * This function creates a soft-lock on document open and removes it when the document is closed.
 * Also dispatch the returned callback to alfresco that handles the document storage.
 * @see https://api.onlyoffice.com/editors/callback for additional info about the $payload array and the meanings of the keys.
 * @param type $node_ref
 * @param type $alfresco_ticket
 * @return type
 */
function gofast_onlyoffice_callback($nid, $node_ref, $alfresco_ticket) {

  $result = '';
  $saving = FALSE;

  $complete_node_ref = 'workspace://SpacesStore/' . $node_ref;

  $onlyoffice_callback_values = file_get_contents("php://input");
  
  //Change OnlyOffice callback URL to use an internal URL
  //Needed to have nginx understand it should relay the request to OnlyOffice
  global $conf;
  
  $onlyoffice_callback_values = str_replace($conf['gofast-comm_domain'], "internal-" . $conf['gofast-comm_domain'], $onlyoffice_callback_values);

  try {
    $payload = json_decode($onlyoffice_callback_values, TRUE);
    // alfresco connector expects "history" to be an object, not an array
    if (empty($payload["history"])) {
      $payload["history"] = new stdClass();
    }
    if (!empty($payload["history"]->changes)) {
      foreach ($payload["history"]->changes as $key => $change) {
        if (isset($change->documentSha256)) {
          unset($payload["history"]->changes[$key]->documentSha256);
        }
      }
    }

    // if the callback is called by the onlyoffice api, onlyoffice still expects a response from the doc server but we don't have to go further
    if (isset($payload["userdata"]) && $payload["userdata"] == "gofast_onlyoffice_is_doc_being_edited") {
      $hash = gofast_onlyoffice_get_document_key($complete_node_ref);
      return gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload);
    }

    if(isset($payload['status'])) {

    $node = node_load($nid);
    $lock_owner = gofast_cmis_node_is_locked($node);
    $save_continue = FALSE;
    $unlock = FALSE;

      // End of session save: editors opened meanwhile must wait for it
      if ($payload['status'] == '2' && !isset($payload['forcesavetype'])) {
        $saving = TRUE;
        gofast_onlyoffice_set_saving($nid, TRUE);
      }

      switch($payload['status']) {
        case '1' :
          // Document opened
          // We need to check if there is a soft_lock, if not, set it to true
          gofast_onlyoffice_document_set_soft_lock($node, TRUE);
          break;
        case '2':
          // Update of the document made, saving, everybody has closed
          if(isset($payload['forcesavetype'])){
              //GoFAST plugin save
              $save_continue = TRUE;
              $onlyoffice_callback_values = json_encode($payload);
          }elseif($payload["notmodified"]) {
            // Don't version if no modification was made since last save on an "alone" session
            $payload['status'] = 4;
            $onlyoffice_callback_values = json_encode($payload);
          }else{
            $unlock = TRUE;
          }
          // We can not set a variable that will tell Drupal to update the document preview
          break;
        case '4':
          // Document closed by all of its users
          $unlock = TRUE;
          break;
        case '6':
          $onlyoffice_callback_values = json_encode($payload);
          $hash = gofast_onlyoffice_get_document_key($complete_node_ref);
          return gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload);
      }
    }
    if ($payload['status'] == 1 || $payload['status'] == 4) {

      // store in cache the list of users (so we can query it later) for 5 minutes
      $cache_key = gofast_onlyoffice_get_document_users_cache_key($payload['key']);
      cache_set($cache_key, $payload['users'], 'cache', time() + (5 /*minutes*/ * 60 /*seconds/min*/));
      // registering the number of connected users to a document.
      // getting map of doc keys => number of users
      $document_user_count_map = variable_get('oo_doc_user_count_list', array());
      //getting currently stored max value (lets us not always call max on the count map)
      $max = variable_get('oo_doc_user_count_max', 0);
      $key = $payload['key'];
      // go through the actions to see connections and deconnections of users. Usually only one action is sent.
      foreach ($payload['actions'] as $action) {
        if ($action['type'] === 1) {
          //make sure there is a number for the document's key
          if (!isset($document_user_count_map[$key])) {
            $document_user_count_map[$key] = 0;
          }
          $document_user_count_map[$key]++;
          $max = max($max, $document_user_count_map[$key]);
        } elseif ($action['type'] === 0) {
          $document_user_count_map[$key]--;
          $max = max($document_user_count_map);
          // "forget" about the document if there are no more users on it
          if ($document_user_count_map[$key] <= 0) {
            unset($document_user_count_map[$key]);
          }
        }
      }
      // set the max value of the period to the max of the current max and the period max. the period is used by the reporting in gofast_update_cron hook.
      variable_set('oo_doc_user_count_max_period', max($max, variable_get('oo_doc_user_count_max_period')));
      variable_set('oo_doc_user_count_max', $max);
      variable_set('oo_doc_user_count_list', $document_user_count_map);
    }

  $hash = gofast_onlyoffice_get_document_key($complete_node_ref);
  $result = gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload);
  if ($unlock) {
    gofast_onlyoffice_document_set_soft_lock($node, FALSE);
  }

    //if we are in case of saving document after OnlyOffice edition, we check if the document is in old office format. If yes, convert it
    if($payload['status'] == '2'){
      usurp($lock_owner->uid);
      $cmis_object = gofast_cmis_node_edit_item_get($node);

      $current_mimetype = $cmis_object->properties["cmis:contentStreamMimeType"];

      watchdog("GOFAST convert document ".$node->nid, $current_mimetype);
    if(gofast_onlyoffice_is_mimetype_must_convert($current_mimetype)){
          sleep(3);
          gofast_cmis_convert_old_office_format_to_new($node);
      }

      usurp(FALSE);
    }

    //Relock the document to continue edition
    if($save_continue){
      sleep(2);
      gofast_onlyoffice_document_set_soft_lock($node, TRUE);

      $payload['status'] = 1;
      $onlyoffice_callback_values = json_encode($payload);

      $result = gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload);
    }

    return $result;
  } catch(Throwable $e) {
    watchdog("gofast_onlyoffice", "Caught: " . $e->getMessage(), [], WATCHDOG_ERROR);
    return gofast_onlyoffice_parashift_callback($hash, $complete_node_ref, $payload);
  } finally {
    if ($saving) {
      gofast_onlyoffice_set_saving($nid, FALSE);
    }
  }
}

/**
 * Flags the end of session save of a document as running, or as done.
 * Once done, the flag is kept a few more seconds: OnlyOffice cleans the
 * session up only after receiving the callback response.
 */
function gofast_onlyoffice_set_saving($nid, $saving) {
  $until = time() + ($saving ? GOFAST_ONLYOFFICE_SAVING_TIMEOUT : GOFAST_ONLYOFFICE_SAVING_GRACE);
  // A dated expiry, unlike CACHE_TEMPORARY, survives cache_clear_all() and lets the cache drop the item afterwards.
  // The data holds it too: expired items still read as valid until the end of the request.
  cache_set('gofast_onlyoffice_saving:' . $nid, $until, 'cache', $until);
}

/**
 * Waits for the end of session save of a document. Joining the session
 * meanwhile makes OnlyOffice reload the previous version from Alfresco and
 * drop the unsaved changes once the save is acknowledged.
 */
function gofast_onlyoffice_wait_for_saving($nid) {
  $deadline = time() + GOFAST_ONLYOFFICE_SAVING_TIMEOUT;
  while (time() < $deadline) {
    $cache = cache_get('gofast_onlyoffice_saving:' . $nid);
    if (empty($cache) || $cache->data <= time()) {
      return;
    }
    sleep(1);
  }
}

function gofast_onlyoffice_is_mimetype_must_convert($current_mimetype){
     switch($current_mimetype){
      case 'application/vnd.ms-excel' :
      case 'application/msword' :
      case 'application/vnd.ms-powerpoint' :
      case 'application/rtf' :
        return true;
        break;
      default:
        return false;
    }
}

/**
 * This function updates the soft_lock for a given node.
 * @param type $node the document to update
 * @param type $value TRUE to set soft lock, FALSE to unset soft lock
 */
function gofast_onlyoffice_document_set_soft_lock($node, $value) {
  $field_value = isset($node->{GOFAST_ONLYOFFICE_SOFT_LOCK}[LANGUAGE_NONE][0]['value']) ? $node->{GOFAST_ONLYOFFICE_SOFT_LOCK}[LANGUAGE_NONE][0]['value'] : NULL;
  if ($node->type === 'alfresco_item' && ($field_value === NULL || ($field_value !== NULL && $field_value !== $value))) {
    $node->{GOFAST_ONLYOFFICE_SOFT_LOCK}[LANGUAGE_NONE][0]['value'] = intval($value);
    gofast_update_field_database($node, GOFAST_ONLYOFFICE_SOFT_LOCK);
  }
}

/**
 * This function returns the current soft lock status of a document
 * @param type $node the node to get it's soft lock status
 * @return boolean TRUE if soft locked, FALSE otherwise
 */
function gofast_onlyoffice_document_get_soft_lock($node) {
  if($node->type === 'alfresco_item' && isset($node->{GOFAST_ONLYOFFICE_SOFT_LOCK}[LANGUAGE_NONE][0]['value'])) {
    return boolval($node->{GOFAST_ONLYOFFICE_SOFT_LOCK}[LANGUAGE_NONE][0]['value']);
  } else {
    return FALSE;
  }
}

/**
 * @param string $doc_id is the OO key of the document (the key is provided by alfresco and has the format alfRef-hash, hash being the encoded last modification timestamp)
 * @return boolean TRUE if a matching editing session exists according to OO API
 */
function gofast_onlyoffice_is_doc_being_edited($doc_id) {
  $response = gofast_onlyoffice_api_query_info_command($doc_id, "gofast_onlyoffice_is_doc_being_edited");
  if (isset($response->error) && $response->error == 1) {
    return FALSE;
  } else {
    return TRUE;
  }
}

/**
 * Request an "info" command to the OnlyOffice command service, fetching information
 * about a document's current edition session.
 *
 * @see https://api.onlyoffice.com/editors/command/info
 * @param string $doc_id OnlyOffice document id of the document to query the info for
 * @param string|null $user_data Arbitrary data to be sent alongside the request.
 *  can be used to identify the request later on
 * @return object The **Command Service**'s response object. This object
 *  contains the key/document ID and this specific request's error status,
 *  **not** the requested document informations. See the onlyoffice documentation on this subject.
 */
function gofast_onlyoffice_api_query_info_command($doc_id, $user_data = null) {
  global $conf;
  $configuration = [
    "c" => "info",
    "key" => $doc_id,
    ...($user_data !== NULL ? ["userdata" => $user_data] : []),
  ];
  $data = ["token" => JWT::encode($configuration, $conf['oo_jwt_secret'], "HS256")];

  $ch = curl_init();
  curl_setopt($ch, CURLOPT_URL, DOC_SERV_COMMAND_SERVICE);
  curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
  curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
  curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
  curl_setopt($ch, CURLOPT_POST, true);
  curl_setopt($ch, CURLOPT_HTTPHEADER, array('Content-Type: application/json'));
  curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
  curl_setopt($ch, CURLOPT_TIMEOUT, DOC_SERV_TIMEOUT);
  $response = curl_exec($ch);
  $response = json_decode($response);
  curl_close($ch);
  return $response;
}

/**
 *
 * Callback of menu item above
 * @param stdClass $node
 * @param bool $ro Display onlyoffice editor as read-only
 * @return string Onlyoffice editor template html
 */
function gofast_onlyoffice_editor($node, $ro = FALSE) {
  if (user_is_logged_in()) {
    if (!$ro) {
      gofast_onlyoffice_wait_for_saving($node->nid);
    }
    $node_ref = gofast_cmis_node_get_item_id($node);
    // This condition checks if the document can be edited with onlyoffice or not.
    // It should not contain a lock a no soft lock otherwise it means we have open
    // the document using an external application (office, dav,...etc.)
    
    if(!$ro && (gofast_cmis_webservice_execute_request("getlocked", $node_ref) !== 'nolocked' && !gofast_onlyoffice_document_get_soft_lock($node))) {
      drupal_set_message(t('The document %document is currently locked by another application and cannot be edited with OnlyOffice.', array('%document' => $node->title)), 'warning');
      drupal_goto('/');
    }
    global $conf;

    // Document's name
    $doc_name = gofast_cmis_item_get($node->{GOFAST_CMIS_REFERENCE_FIELD}[LANGUAGE_NONE][0]['value'])->properties['cmis:contentStreamFileName'];

    // Document id
    if(!$ro){
        $hash = gofast_onlyoffice_get_document_key($node->{GOFAST_CMIS_REFERENCE_FIELD}[LANGUAGE_NONE][0]['value']);
        $doc_id = gofast_cmis_get_raw_item_id($node->{GOFAST_CMIS_REFERENCE_FIELD}[LANGUAGE_NONE][0]['value']) . '_' . $hash;
    }

    if($ro){
        $doc_config = gofast_onlyoffice_get_config($node, gofast_generate_uuid(), "", "readonly");
        $token = JWT::encode($doc_config, $conf['oo_jwt_secret'], "HS256");
  
        return theme('onlyoffice_ro', array(
          'nid' => $node->nid,
          'filename' => $doc_name,
          'token' => $token,
          'docConfig' => json_encode($doc_config, JSON_HEX_APOS),
        ));
    }else{
      $doc_config = gofast_onlyoffice_get_config($node, $doc_id);
      $token = JWT::encode($doc_config, $conf['oo_jwt_secret'], "HS256");
      $local_storage = [];
      if (module_exists("gofast_mistral")) {
        global $base_url;
        $local_storage["GoFASTAIApiKey"] = $conf['gofast-iagent-jwt-token'];
        $local_storage["GoFASTAIApiEndpoint"] = $base_url;
        $local_storage["GoFASTAIApiModel"] = empty($conf['gofast-iagent-saas-model']) ? "mistral-small-latest" : $conf['gofast-iagent-default-model-id'];
      }

      return theme('onlyoffice', array(
        'filename' => $doc_name,
        'token' => $token,
        'docConfig' => json_encode($doc_config, JSON_HEX_APOS),
        'localStorage' => $local_storage,
        'commDomain' =>  $conf['gofast-comm_domain'],
      ));
    }
  } else {
   drupal_goto('/');
  }
}

/**
 * Render the onlyoffice editor for the given node
 * 
 * Proceed in the same way as in drupal_ajax_delivery, but using page_callback
 * because delivery_callback is called even if access_callback fails.
 *
 * @param stdClass $node
 * @return void
 */
function gofast_onlyoffice_render_editor($node) {
  print gofast_onlyoffice_editor($node);
  drupal_exit();
}

/**
 * @package gofast_cmis
 * Implements hook_field_access().
 */
function gofast_onlyoffice_field_access($op, $field, $entity_type, $entity, $account) {
  if (empty($entity)) {
    // We are in field settings page.
    return;
  }

  // Fields that should be maintained internally.
  $fields = array(
    GOFAST_ONLYOFFICE_SOFT_LOCK,
  );

  if ($op === 'edit' && in_array($field['field_name'], $fields)) {
    return FALSE;
  }
}

/*
 * Configure share variables
*/
function gofast_onlyoffice_configure_share(){
  global $conf;
  
  $url = "http://localhost:8080/alfresco/service/onlyoffice/onlyoffice-config";
  $username = "admin";
  $password = gofast_get_admin_pwd();

  //Onlyoffice configuration
  $postfields = [
    'alfurl' => "",
    'cert' => "true",
    'customization' => [
      'forcesave' => "true",
    ],
    'innerurl' => "",
    'jwtsecret' => $conf['oo_jwt_secret'],
    'url' => "https://internal-" . $conf['gofast-comm_domain'] . "/",
    'webpreview' => "false",
    'formats' => [
      'csv' => "true",
      'odp' => "true",
      'ods' => "false",
      'odt' => "false",
      'rtf' => "false",
      'txt' => "true",
    ],
    'demo' => "false",
    'convertOriginal' => "false",
    "chat" => "true",
    "help" => "true",
    "compactHeader" => "false",
    "toolbarNoTabs" => "false",
    "feedback" => "false",
    "reviewDisplay" => "false",
  ];

  $postfields = json_encode((object)$postfields);

  $ch = curl_init();
  curl_setopt($ch, CURLOPT_POST, 1);
  curl_setopt($ch, CURLOPT_HTTPHEADER, array(
        'Content-Length: ' . strlen($postfields),
        'Content-Type: application/json'
    ));
  curl_setopt($ch, CURLOPT_CUSTOMREQUEST, "POST");
  curl_setopt($ch, CURLOPT_HEADER, 0);
  curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
  curl_setopt($ch, CURLOPT_USERPWD, $username . ":" . $password);
  curl_setopt($ch, CURLOPT_URL, $url);
  curl_setopt($ch, CURLOPT_POSTFIELDS, $postfields);
  curl_exec($ch);
}
