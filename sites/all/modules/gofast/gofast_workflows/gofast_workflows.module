/**
 * Implements hook_entity_insert()
 */
function gofast_workflows_entity_insert($entity, $entity_type) {
  //create space on Bonita
  if ($entity_type === 'node' && gofast_og_is_space($entity, FALSE)) {
      watchdog("debug create group", $entity->title);
      gofast_workflows_create_group($entity);
  }

  if($entity_type == "userlist"){
      gofast_workflows_create_userlist($entity);
  }
}

/**
 * Add a new target database on the current connection.
 *
 * The target is named `bonita` if `$bdm` is `FALSE`, `bonita_bdm` if `$bdm` is `TRUE`.
 *
 * Each target is mapped to the bonita MySQL DB of the same name.
 *
 * @param bool $bdm
 *   Whether to add the `bonita_bdm` target instead of `bonita`.
 *
 *   Defaults to `FALSE`.
 * @param bool $allow_bdm
 *   Whether to allow using bdm tables during requests. This parameter only
 *   takes effect when $bdm is `FALSE`.
 *
 *   When `TRUE` and `$bdm` is `FALSE` a set of prefixes for the BDM table names
 *   are added. This way, the table names can be used as-is while using the
 *   Drupal database API (`db_select()`, etc.) and will be automatically
 *   prefixed with the `bonita_bdm` database name when using the `bonita` target.
 *
 *   Defaults to `FALSE`
 *
 * @return void
 *   Adds a DB connection target.
 */
function gofast_workflows_activate_bonita_connection($bdm = FALSE, $allow_bdm = FALSE) {
    $drupal_db_info = Database::getConnectionInfo()["default"];
    $database = "bonita";
    if ($bdm) {
        $database .= "_bdm";
    }
    $bonita_database = array_merge($drupal_db_info, array("database" => $database, "username" =>  variable_get_value('bonita_mysql_user'), "password" => variable_get_value('bonita_mysql_password')));
    unset($bonita_database["port"]);
    unset($bonita_database["prefix"]);

    // This is somewhat of a hacky solution to allow joining between tables in
    // both the `bonita` and `bonita_bdm` databases/schemas in a single request
    // using the Drupal database API (`db_select()`, etc.).
    if (!$bdm && $allow_bdm) {
        $bdm_tables = [
            'CONTENTCURRENT',
            'CONTENTHISTORY',
            'LINEHISTORY',
            'LINEHISTORY_CONTENTS',
            'PROCESSCURRENT',
            'PROCESSCURRENT_CONTENTS',
            'PROCESSHISTORY',
            'PROCESSHISTORY_LINES',
        ];
        // Add prefixes for BDM, allows joining between the two databases.
        $bonita_database["prefix"] = array_fill_keys($bdm_tables, 'bonita_bdm.');
    }

    // will add only if it has not been added yet
    Database::addConnectionInfo('default', $database, $bonita_database);
}

function gofast_workflows_debug(){
    return gofast_workflows_get_available_processes(false);
}


function gofast_workflows_prepare_post_fields($array) {
        $params = array();
        foreach ($array as $key => $value) {
            $params[] = $key . '=' . urlencode($value);
        }
        return implode('&', $params);
}


/**
 * Function that returns the bonita id of the user received as a parameter
 */
function gofast_workflows_get_user_id($myuser){
   $cookie_name = "cookie_bonita".BONITA_TECHNICAL_LOGIN.".txt";

   if(!isset($myuser->uid)){
       return null;
   }

    if($myuser->name == BONITA_TECHNICAL_LOGIN){
         return true;
    }
    $bonita_id = gofast_workflows_get_bonitaid_from_database($myuser->uid);

    if($bonita_id){
        return $bonita_id;
    }else{
        gofast_workflows_get_cookie(true);
        $array_results = (array) gofast_workflows_curl_get_user($myuser,$cookie_name);

        if(count($array_results) > 0){
            if(isset($array_results[0])){
                $id = $array_results[0]["id"];
            }
            gofast_workflows_set_bonitaid_in_database($myuser->uid, $id);
        }else{
            $id = null;
        }

        return $id;
    }
}

/*
 * Dashboard menu entry
 */
/*
 * Prepares the auto-opening of a Bonita task form in a modal over the dashboard.
 * Used by the "Execute Task" link of workflow notification emails.
 */
function gofast_workflows_dashboard_prepare_execute_task($taskId){
    //Retrieve the task to build the parameters needed to open its form
    $task = gofast_workflows_get_task_object($taskId);

    //Task no longer available (already done, deleted, or not accessible to this user): tell the JS to show a toast over the dashboard
    if(empty($task) || empty($task["case_object"]) || empty($task["case_object"]["processDefinitionId"])){
        drupal_add_js(array('gofast_workflows' => array('execute_task_unavailable' => true)), 'setting');
        return;
    }

    $process_definition = $task["case_object"]["processDefinitionId"];
    //force_assign is needed when the task is assigned to an actor/group rather than a specific user
    $force_assign = empty($task["assigned_id"]) ? "true" : "false";

    //Pass the task info to the JS behavior that opens the modal on page load
    drupal_add_js(array('gofast_workflows' => array('execute_task' => array(
        'task_id' => $taskId,
        'process' => $process_definition["name"] . "/" . $process_definition["version"],
        'task_name' => rawurlencode($task["name"]),
        'force_assign' => $force_assign,
    ))), 'setting');
}

function gofast_workflows_dashboard(){
    $args = func_get_args();
    drupal_set_title(t("Workflows dashboard", array(), array('context' =>"gofast:gofast_workflows")));

    //When opened from the "Execute Task" link of a notification email, auto-open the task form in a modal
    if(!empty($_GET['execute_task'])){
        gofast_workflows_dashboard_prepare_execute_task($_GET['execute_task']);
    }

    //Render and return the dashboard page
    if (!empty($args) && $args[0] == "legacy") {
        //Add stats JS
        drupal_add_js(drupal_get_path('module', 'gofast_workflows') . '/js/gofast_workflows_stats.js');
        //Retrieve search form
        $search_form = drupal_render(drupal_get_form("gofast_workflow_dashboard_search_form"));
        $output = theme("workflow_complete_dashboard_legacy", array('search_form' => $search_form));
    } else {
        global $user;
        $output = theme("workflow_complete_dashboard", array('language' => $user->language));
    }
    return gofast_create_page_content($output, 'content-fluid');
}

/*
 * Search form for workflows full dashboard
 */
function gofast_workflow_dashboard_search_form(){
    $form['title'] = array(
        '#type' => 'textfield',
        '#title' => t("Process title", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="form-wrapper form-group"><div class="col-md-4" style="float:left;">',
        '#suffix' => '</div>'
    );

    $form['started'] = array(
        '#type' => 'textfield',
        '#title' => t("Started after", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="col-md-4" style="float:left;">',
        '#suffix' => "</div>",
        "#attributes" => array(
            "class" => array("gofastDatepicker"),
            "data-toggle" => "datepicker",
            'data-target' => '#edit-started',
       ),
       '#field_suffix' => _bootstrap_icon("calendar")
    );

    $form['deadline'] = array(
        '#type' => 'textfield',
        '#title' => t("Deadline before", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => "<div class='col-md-4' style='float:left;'>",
        '#suffix' => "</div></div>",
        "#attributes" => array(
            "class" => array("gofastDatepicker"),
            "data-toggle" => "datepicker",
            'data-target' => '#edit-deadline',
       ),
       '#input_group' => TRUE,
       '#field_suffix' => _bootstrap_icon("calendar")
    );

    $workflow_definitions = array();
    foreach(gofast_workflows_get_list_available_processes(false, false) as $definition){
        if ($definition["name"] == "Document broadcast subprocess") {
            continue;
        }
        $workflow_definitions[$definition['name']] = t($definition['displayName'], array(), array('context' => 'gofast:gofast_workflows'));
    }
    $form['type'] = array(
        '#type' => 'select',
        '#title' => t("Workflow type", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="form-wrapper form-group"><div class="col-md-4" style="float:left;">',
        '#suffix' => '</div>',
        '#options' => array_merge(array("all" => t("All", array(), array('context' => 'gofast:gofast_workflows'))), $workflow_definitions),
        '#default_value' => "all"
    );

    $form['state'] = array(
        '#type' => 'select',
        '#title' => t("Workflow state", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="col-md-4" style="float:left;">',
        '#suffix' => "</div>",
        '#options' => array("progress" => t("In progress", array(), array('context' => 'gofast:gofast_workflows')), "finished" => t("Finished", array(), array('context' => 'gofast:gofast_workflows'))),
        '#default_value' => "progress"
    );

    $form['creator'] = array(
        '#type' => 'textfield',
        '#title' => t("Started by", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="col-md-4" style="float:left;">',
        '#suffix' => "</div></div>",
        '#name' => 'ac-list-tags-list-creator',
        '#attributes' => [
            'class' => ['form-control-tags js-tagify'],
            'data-user' => '', // show ac users
            'data-userlist' => '', // show ac userlist
            'data-extract-user' => '', // extract user from space
        ],
    );

    $form['documents'] = array(
        '#type' => 'textfield',
        '#title' => t("Associated documents", array(), array("context" => "gofast:gofast_workflows")),
        '#name' => 'ac-list-tags-list-documents',
        '#attributes' => [
            'id' => 'edit-list-documents',
            'class' => ['form-control-tags js-tagify'],
            'data-node' => '', // show ac node
        ],
        '#maxlength' => '',
        '#prefix' => '<div class="form-wrapper form-group"><div class="col-md-6" style="float:left;">',
        '#suffix' => '</div>',
    );

    $form['users'] = array(
        '#type' => 'textfield',
        '#title' => t("Associated users", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => '<div class="col-md-6" style="float:left;">',
        '#suffix' => "</div></div>",
        '#name' => 'ac-list-tags-list-users',
        '#attributes' => [
            'class' => ['form-control-tags js-tagify'],
            'data-user' => '', // show ac users
            'data-userlist' => '', // show ac userlist
            'data-extract-user' => '', // extract user from space
        ],
    );

    //Create hook to retrieve custom form fields
    $fields = array();
    foreach(module_implements("workflow_dashboard_search_fields") as $module){
        $fields += call_user_func($module . "_workflow_dashboard_search_fields", $form);
    }

    $pos = 0;
    foreach($fields as $k => $field){
        //Set suffix and prefix to our form elements
        switch($pos){
            case 0:
                $field['#prefix'] = '<div class="form-wrapper form-group"><div class="col-md-4" style="float:left;">';
                $field['#suffix'] = '</div>';
                $pos = 1;
                break;
            case 1:
                $field['#prefix'] = '<div class="col-md-4" style="float:left;">';
                $field['#suffix'] = '</div>';
                $pos = 2;
                break;
            case 2:
                $field['#prefix'] = '<div class="col-md-4" style="float:left;">';
                $field['#suffix'] = '</div></div>';
                $pos = 0;
                break;
            default:
                break;
        }

        //Close last element
        if(count($fields) == ($k+1)){
            $field['#suffix'] = '</div></div>';
        }

        //Set field in the form
        $form['custom_' . $k] = $field;
    }

    $form['search'] = array(
        '#type' => 'button',
        '#value' => t("Search", array(), array("context" => "gofast:gofast_workflows")),
        '#prefix' => "<div style='clear: both;'></div>",
        '#attributes' => array('onclick' => "Gofast.gofast_workflow_search(event)")
    );
    
    return $form;
}

/**
 * Given a Bonita ID, return the matching Drupal ID from Drupal database
 * @return int|false
 */
function gofast_workflows_get_uid_from_database($bid) {
    $users = db_select("field_data_field_bonita_id", "bid")->fields("bid", ["entity_id"]);
    $users->innerJoin("users", "u", "bid.entity_id = u.uid");
    $users->condition("bid.field_bonita_id_value", $bid);
    $users = $users->execute()->fetchCol(); 
    return reset($users);
}

/**
 * Given a Drupal ID, return the matching Bonita ID from Drupal database
 * @return int|false
 */
function gofast_workflows_get_bonitaid_from_database($uid) {
    return reset(db_select("field_data_field_bonita_id", "bid")->fields("bid", ["field_bonita_id_value"])->condition("entity_id", 
    $uid)->execute()->fetchCol());
}

/**
 * Insert a Drupal ID / Bonita ID association to the database
 */
function gofast_workflows_set_bonitaid_in_database($uid, $bid) {
    if($bid == 'null'){
        return;
     }
     
    db_delete("field_data_field_bonita_id")->condition("entity_id", $uid)->execute();
    $fields = [
        "entity_type" => "user",
        "bundle" => "user",
        "deleted" => 0,
        "entity_id" => $uid,
        "revision_id" => $uid,
        "language" => LANGUAGE_NONE,
        "delta" => 0,
        "field_bonita_id_value" => $bid,
    ];
    db_insert("field_data_field_bonita_id")->fields($fields)->execute();
    entity_get_controller('user')->resetCache([$uid]);
    cache_clear_all("field:user:$uid", 'cache_field');
}

/*
 * Return bonita ids from an array of uids
 */
function gofast_workflows_get_bonitaids_from_uids($uids = null){
    if($uids == null && isset($_GET["uids"])){
        //This is an ajax call
        $ajax = true;

        $uids = is_array($_GET['uids']) ? $_GET['uids'] : [];
    }

    $output = array();

    foreach($uids as $uid){
        $output[] = gofast_workflows_get_user_id(user_load($uid));
    }

    if($ajax){
        print json_encode($output);
        exit;
    }else{
        return $output;
    }
}

function gofast_workflows_dashboard_rapide($node = NULL, $full_page = false){

    if(isset($_GET["async"])){
        $api = true;
