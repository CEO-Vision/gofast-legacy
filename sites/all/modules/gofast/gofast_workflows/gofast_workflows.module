    setcookie('bonita_sess_timestamp', '0', 0, '/', "", true);
}


 function gofast_workflows_og_membership_insert(OgMembership $og_membership) {
  if ($og_membership->entity_type === 'user' || $og_membership->entity_type === 'userlist') {
       $group_node = node_load($og_membership->gid);
     if($group_node->type == "public"){
         return;
     }
      if($og_membership->entity_type === 'userlist' && !gofast_og_is_root_space($group_node)){
          gofast_workflows_add_node_to_resync_oncron($group_node->nid);
      }elseif($og_membership->entity_type === 'user' && !gofast_og_is_root_space($group_node)){
         $myuser = user_load($og_membership->etid);
         $bonita_uid = gofast_workflows_get_user_id($myuser);
          if($bonita_uid !== null){
              //on recupere le groupe Bonita qui correspond au groupe drupal recu en parametre
              $bonita_group = gofast_workflows_get_bonitagroup_from_gofastgroup($group_node);
              watchdog("debug workflow", "add user ".$bonita_uid." into space ".$bonita_group["id"]);
              gofast_workflows_curl_add_user_into_bonitagroup($bonita_uid, $bonita_group["id"]);
          }
      }

   }
 }

 function gofast_workflows_og_membership_delete(OgMembership $og_membership) {
  if ($og_membership->entity_type === 'user' || $og_membership->entity_type === 'userlist') {
      $group_node = node_load($og_membership->gid);
      if($og_membership->entity_type === 'userlist' && !gofast_og_is_root_space($group_node)){
          gofast_workflows_add_node_to_resync_oncron($group_node->nid);

      }elseif($og_membership->entity_type === 'user' && !gofast_og_is_root_space($group_node)){
         $myuser = user_load($og_membership->etid);
         $bonita_uid = gofast_workflows_get_user_id($myuser);
          if($bonita_uid !== null){
              //on recupere le groupe Bonita qui correspond au groupe drupal recu en parametre
              $bonita_group = gofast_workflows_get_bonitagroup_from_gofastgroup($group_node);
              watchdog("debug workflow", "remove user ".$bonita_uid." into space ".$bonita_group["id"]);
              //gofast_workflows_curl_add_user_into_bonitagroup($bonita_uid, $bonita_group["id"]);
              gofast_workflows_curl_delete_user_from_bonitagroup($bonita_uid, $bonita_group["id"]);
          }
      }
  }
 }

 function gofast_workflows_entity_update($entity, $type) {
     if($type == "userlist"){
         //check old members
         $old_title = $entity->original->title;
         $new_title = $entity->title;
         if($old_title !== $new_title){
            gofast_workflows_update_userlist($entity);
         }
        $old_members = $entity->original->field_userlist_members;
        $new_members = $entity->field_userlist_members;

        if($new_members !== $old_members){
            $og_userlist_node = (array) $entity->og_userlist_node[LANGUAGE_NONE];
            if(count($og_userlist_node) > 0){
                foreach($og_userlist_node as $array_node){
                    $node = node_load($array_node['target_id']);
                    if(!gofast_og_is_root_space($node) && $node->type !== "public"){
                        gofast_workflows_add_node_to_resync_oncron($node->nid);

                    }
                }
            }
            gofast_workflows_synchronize_members_userlist($entity);
        }
        
     }elseif(gofast_og_is_space($entity)){
        $old_title = $entity->original->title;
        $new_title = $entity->title;
        if($old_title !== $new_title){
            gofast_workflows_update_group($entity, $entity->original);
        }
     }
 }

/**
 * Access callback: whether the current user may see a Bonita case, with the
 * tasks dashboard rules (search permissions, then taking part in the case).
 */
function gofast_workflows_user_can_view_case($case_id) {
    global $user;
    if (!user_access('access content') || !ctype_digit((string) $case_id)) {
        return FALSE;
    }
    gofast_workflows_activate_bonita_connection();
    $options = array('target' => 'bonita');
    $args = array(':id' => (int) $case_id);
    $name = db_query(
        <<<'SQL'
        SELECT name FROM process_instance WHERE id = :id
        UNION SELECT name FROM arch_process_instance WHERE sourceObjectId = :id
        LIMIT 1
        SQL,
        $args,
        $options
    )->fetchField();
    if ($name === FALSE) {
        return FALSE;
    }

    $action = 'default';
    foreach (gofast_workflows_get_search_permissions() as $permission) {
        if ($permission['type'] == 'process_name' && in_array($permission['condition'], array('*', $name)) && $permission['exclusion_condition'] != $name) {
            $action = $permission['action'];
        }
    }
    if ($action != 'default') {
        return $action == 'allow';
    }

    // Initiator, assignee or executor of a task, or participant of the running case
    $args += array(
        ':uid' => db_query(
            "SELECT id FROM user_ WHERE userName = :name",
            array(':name' => $user->name),
            $options
        )->fetchField(),
        ':list' => '%' . db_like('<string>' . $user->name . '</string>') . '%',
    );
    return (bool) db_query(
        <<<'SQL'
        SELECT 1 FROM process_instance WHERE id = :id AND startedBy = :uid
        UNION ALL SELECT 1 FROM arch_process_instance WHERE sourceObjectId = :id AND startedBy = :uid
        UNION ALL SELECT 1 FROM flownode_instance WHERE rootContainerId = :id AND :uid IN (assigneeId, executedBy)
        UNION ALL SELECT 1 FROM arch_flownode_instance WHERE rootContainerId = :id AND :uid IN (assigneeId, executedBy)
        UNION ALL SELECT 1 FROM data_instance WHERE containerId = :id AND name = 'list_all' AND clobValue LIKE :list
        LIMIT 1
        SQL,
        $args,
        $options
    )->fetchField();
}

/**
 * Get permissions for the workflow search API.
 *
 * By default, it restricts search to the current user.
 *
 * Modules can change this by implementing a hook_workflows_search_permissions().
 *
 * @return (array{
 *  type: string,
 *  condition: string,
 *  action: string,
 *  exclusion_condition: string,
 * }[])
 *   Array of search permission structured arrays.
 *
 * @see gofast_api_workflows_search_permissions()
 *   For the API endpoint handler returning this data.
 */
function gofast_workflows_get_search_permissions() {
    $permissions = array(
        array(
            'type' => 'process_name',
            'condition' => "*",
            'action' => 'default',
            'exclusion_condition' => "",
        ),
    );

    foreach (module_implements("workflows_search_permissions") as $module) {
        $permissions = call_user_func_array($module . '_workflows_search_permissions', array($permissions));
    }

    return $permissions;
}

/**
 * Return permissions for the search API
 * Default behavior of the permissions will be to restrict the search to our current user, let's allow modules to alter this
 *
 * @param array $_params
 *   API request parameters array.
 *
 * @return never
 *   Outputs the response and exits.
 *
 * @see gofast_workflows_get_search_permissions()
 *   To simply get the list of permission arrays from code.
 */
function gofast_api_workflows_search_permissions($_params) {
    $output = gofast_workflows_get_search_permissions();
    gofast_api_success($output);
}

 /*
  * Implements GoFAST API
  * Ressource : workflows
  * Action : dashboard
  * Method : GET
  *
  * This API replaces the old Java / Bonita API to retrieve elements to display in
  * the workflows dashboard with filters, sorting and pagination
  */
function gofast_api_workflows_dashboard($params, $api = TRUE, $bypass_access = FALSE){
    //Don't allow external access to this API as it's called by the old Java API internally
    if(gofast_workflows_is_external_api() && $api && !$bypass_access){
        gofast_api_forbidden("Unavailable action for external requester");
    }

    // We'll need the bonita target, potentially with access to bdm tables.
    gofast_workflows_activate_bonita_connection(allow_bdm: TRUE);

    //Prepare output
    $output = array();

    //Extract pagination parameters
    $p = intval(trim($params['p']));
    $c = intval(trim($params['c']));

    //Extract filters params
    $startedby = trim($params['startedby']);
    $type = trim($params['type']);
    $state = trim($params['state']);
    $title = trim($params['title']);
    $started = trim($params['started']);
    $deadline = trim($params['deadline']);
    $documents = is_array($params['documents']) ? $params['documents'] : json_decode(trim($params['documents']), TRUE);
    $users = is_array($params['users']) ? $params['users'] : json_decode(trim($params['users']), TRUE);
    $bonita_id = trim($params['current_user']);
    $current_user = gofast_workflows_get_drupalid_from_bonitaid($bonita_id);
    $current_user_object = user_load($current_user);
    $custom = is_array($params['custom']) ? $params['custom'] : json_decode(trim($params['custom']), TRUE);

    //Parse custom params
    $custom_parsed = array();
    foreach($custom as $custom_element){
        $custom_element = explode('|', $custom_element);
        $custom_parsed[$custom_element[0]][] = $custom_element[1];
    }

    //Start to build the query
    $query_base_options = ['target' => 'bonita'];
    db_query("SET @@sql_mode=(SELECT REPLACE(@@sql_mode,'ONLY_FULL_GROUP_BY',''))", [], $query_base_options);
    db_query("SET SESSION group_concat_max_len = 15000;", [], $query_base_options);

    $query = NULL;
    if ($state == 'progress') {
        //Search for active cases
        $query = db_select('process_instance', 'pi', $query_base_options);
    } else {
        //Search for archived cases
        $query = db_select('arch_process_instance', 'pi', $query_base_options);
    }
    $query->distinct()->fields('pi', ['rootProcessInstanceId', 'name', 'startDate', 'startedBy']);

    //Associate initiator user informations as we may need it
    $query->leftJoin('user_', 'u', 'u.id = pi.startedBy');

    //We may need to associate the processCurrent for some filters, prepare closures to join it
    /**
     * Helper local "function" (actually a Closure) that takes a callable to
     * return decorated so that it runs at most once. Whether the closure has
     * run can be retrieved using the second output reference parameter. All
     * subsequent calls return the same value as the first call.
     */
    $once = function ($fn, &$has_run = NULL) {
        $has_run = FALSE;
        $return_value = NULL;
        return function (...$args) use (&$has_run, $fn, &$return_value) {
            if ($has_run) return $return_value;
            $has_run = TRUE;

            return $return_value = $fn(...$args);
        };
    };

    /**
     * Closure that guarantees a join on the PROCESSCURRENT table with the alias
     * `pc` has been added once run at least once.
     *
     * PROCESSCURRENT contains information about the state of tasks of the processes.
     *
     * Call this before using the PROCESSCURENT (pc) table.
     *
     * @var (Closure(): void) $require_process_current_table
     */
    $require_process_current_table = $once(function () use (&$query) {
        // Join details about process task states.
        $query->join(
            'PROCESSCURRENT',
            'pc',
            'pc.PID = pi.rootProcessInstanceId',
        );
    });

    /**
     * Closure that guarantees a join on the CONTENTCURRENT and
     * PROCESSCURRENT_CONTENTS tables with the aliases `cc` and `pcc`
     * respectively once run at least once.
     *
     * CONTENTCURRENT contains the data associated with process variables that
     * get passed around the tasks.
     *
     * Call this before using the CONTENTCURRENT (cc) and
     * PROCESSCURRENT_CONTENTS (pcc) tables.
     *
     * For the needs of joining the tables, this also requires the PROCESSCURRENT
     * table and therefore adds a join to it using the
     * $require_process_current_table closure.
     *
     * @var (Closure(): void) $require_process_current_content_table
     */
    $require_process_current_content_table = $once(function () use (
        &$query,
        $require_process_current_table,
    ) {
        // Current content requires current process
        $require_process_current_table();

        // Join details about process data, variables, etc.
        $query->leftJoin(
            'PROCESSCURRENT_CONTENTS',
            'pcc',
            'pcc.PROCESSCURRENT_PID = pc.persistenceId',
        );
        $query->leftJoin(
            'CONTENTCURRENT',
            'cc',
            'cc.persistenceId = pcc.CONTENTCURRENT_PID',
        );
    });

    //Check if we have filters to display and filter the query

    //Start to build conditions

    //Exclude subprocesses
    $query->where('pi.callerId = -1');

    if($state != "progress"){
        //Filter archived processes containing an end date only (really finished)
        $query->where('pi.endDate != 0');
    }

    //Filter by creator
    if(!empty($startedby)){
        $query->condition('pi.startedBy', $startedby, '=');
    }

    //Filter by type (of workflow)
    if(!empty($type) && $type != "all"){
        $query->condition('pi.name', $type, '=');
    }

    //Filter by title
    $title = trim($title);
    if(!empty($title)){
        //Join process current and append the query
        $require_process_current_table();

        $query->condition('pc.TITLE', '%' . db_like($title) . '%', 'LIKE');
    }

    //Filter by start date
    if(!empty($started)){
        $query->condition('pi.startDate', date('U', strtotime($started)) . '000', '>');
    }

    //Filter by deadline
    if(!empty($deadline)){
        //Join process current and append the query
        $require_process_current_table();

        $query->condition('pc.END_DATE', $deadline, '<');
    }

    //Get Bonita search permissions
    if($api){usurp($current_user);}
    $permissions = gofast_workflows_get_search_permissions();
    if($api){usurp(FALSE);}

    //Implements default permissions
    foreach(gofast_workflows_get_list_available_processes(false, false, $current_user) as $definition){
        if(!empty($type) && $type != "all" && $type != $definition['name']){
            //We are filtering on a single process so we won't implement other processes permissions
            continue;
        }
        if ($definition["name"] == "Document broadcast subprocess") {
            continue;
        }

        //Prepare / Reset variables
        $rule_action = "default";

        foreach($permissions as $permission){
            //Process name condition
            if($permission['type'] == "process_name"){
                //Check if our condition is matching the current process_name
                if(($permission['condition'] == $definition['name'] || $permission['condition'] == "*") && $definition['name'] != $permission['exclusion_condition']){
                    $rule_action = $permission['action'];
                }
            }
        }

        if($rule_action == "deny"){
            //Don't display this process
            $query->condition('pi.name', $definition['name'], '!=');
        }else if($rule_action == "default"){
            //Display this process only if we created it or if we are being part of it
            $part_of_process_or = db_or()
                    ->condition('pi.name', $definition['name'], '!=')
                    ->condition('pi.startedBy', $bonita_id, '=');

            if(empty($documents) || empty($users) || empty($custom_parsed['contents'])){
                //Join process current and process current contents (!performance!)
                $require_process_current_content_table();

                //Check if we are part of the process
                $part_of_process_or->condition(
                    db_and()
                        ->where("cc.NAME = 'User'")
                        ->condition(
                            'cc.CONTENT_VALUE',
                            '%' . db_like($current_user_object->name) . '%',
                            'LIKE',
                        ),
                );
            }

            $query->condition($part_of_process_or);
        }
    }

    //Filter by documents or users
    if(!empty($documents) || !empty($users) || !empty($custom_parsed['contents'])){
        //Join process current and process current contents (!performance!)
        $require_process_current_content_table();

        //Implements permissions based on grouped BDM query
        $query->addExpression('GROUP_CONCAT(cc.NAME, cc.TYPE, TRIM(cc.CONTENT_VALUE))', 'contents');

        //Start grouping now and filter after grouping and concat
        $query->groupBy('pi.rootProcessInstanceId');

        foreach($documents as $document){
            $query->havingCondition('contents', '%Documentnode' . db_like(trim($document)) . '%', 'LIKE');
        }

        foreach($users as $user){
            $query->havingCondition('contents', '%Useruser["' . db_like(user_load(gofast_workflows_get_drupalid_from_bonitaid(trim($user)))->name) . '"%', 'LIKE');
        }

        foreach($custom_parsed['contents'] as $custom_parsed_element){
            // Addressing SQL injection, unsure if this should be wrapped in 'db_like':
            // - Original string concat did not add static wildcards like others
            // - Still used 'LIKE', not '='
            // => Probably receives values with wildcards? Or allows them?
            $query->havingCondition('contents', $custom_parsed_element, 'LIKE');
        }
    }

    if(!empty($custom_parsed['title'])){
        foreach($custom_parsed['title'] as $custom_parsed_element){
            //Join process current and append the query
            $require_process_current_table();

            $query->condition('pc.TITLE', '%' . db_like($custom_parsed_element) . '%', 'LIKE');
        }
    }

    if(!empty($custom_parsed['order'])){
        if (preg_match(
            '/^\s*(?<field>.+?)\s*(?:\s(?<order>(?i)ASC|DESC))?\s*$/',
            $custom_parsed['order'][0],
            $matches,
        )) {
            // Occitanie's module adds sorting options but sends requests with
            // the old raw table column names to sort on. We map them here
            // quickly so that no more adaptations is needed and public API does
            // not change for now.
            // FIXME: change public API to more sensible design where user does
            // not need to know or hardcode bonita table column names. Or leave
            // it until removed when new dashboard fully replaces the legacy one.
            $field_replacements_map = [
                ['/^bonita\.user_\./', 'u.'],
            ];
            $field = $matches['field'];
            foreach($field_replacements_map as [$pattern, $replace]) {
                $field = preg_replace($pattern, $replace, $field, -1, $replace_count);
                if ($replace_count > 0) break;
            }

            $query->orderBy(
                $field,
                !empty($matches['order']) ? strtoupper($matches['order']) : 'ASC',
            );
        }
    }

    //Paginate the result
    $first_index = ($p*$c);

    $query->range($first_index, $c);

    //Get the query results
    $results = $query->execute();

    //Extract results and needed field to build the output array
    foreach($results as $result){
        //Retrive case variables
        $pid = $result->rootProcessInstanceId;
        $start = date('c', substr($result->startDate, 0, -3));
        
        if($api){usurp($current_user);}
        $tasks = gofast_workflows_get_list_actives_tasks(FALSE, $pid, FALSE, FALSE);
        $archived_tasks = gofast_workflows_get_list_actives_tasks(TRUE, $pid, FALSE, FALSE);
        if($api){usurp(FALSE);}

        $process_current = gofast_workflows_get_processcurrent_from_pid($pid);

        $process_current_infos = gofast_workflows_get_processcurrent_infos_from_pid($pid)[0];
        $process_history_infos = gofast_workflows_get_processhistory_infos_from_pid($pid)[0];

        //Parse the ProcessCurrent to retrieve some variables
        $documents = array();
        foreach($process_current as $content_current){
            switch($content_current->NAME){
                case "Document":
                    $documents[] = trim($content_current->CONTENT_VALUE);
                    break;
                default:
                    break;
            }
        }

        //Retrieve some variables in the processCurrent and processHistory infos
        $deadline = $process_current_infos->END_DATE;
        $title = $process_current_infos->TITLE;
        $hid = $process_history_infos->persistenceId;

        $output[] = array(
            'id' => $pid,
            'start' => $start,
            'deadline' => $deadline,
            'title' => $title,
            'type'=> $result->name,
            'startedby' => $result->startedBy,
            'todo_count' => count($tasks),
            'done_count' => count($archived_tasks),
            'hid' => $hid,
            'documents' => $documents,
            'state' => $state,
        );
    }
    if(!$api){
        return $output;
    }
    gofast_api_success($output);
}

// Return all filtered case ids
function gofast_api_get_case_ids($params){
    //Check authentication
    global $user;
    if($user->uid == 0){
        gofast_api_not_authorized("Unavailable ressource for anonymous user");
    }

    //Extract pagination parameters
    $p = intval(trim($params['p']));
    $c = intval(trim($params['c']));

    //Extract filters params
    $startedby = trim($params['startedby']);
    $type = trim($params['type']);
    $state = trim($params['state']);
    $title = trim($params['title']);
    $started = trim($params['started']);
    $deadline = trim($params['deadline']);
    $documents = is_array($params['documents']) ? $params['documents'] : json_decode(trim($params['documents']), TRUE);
    $users = is_array($params['users']) ? $params['users'] : json_decode(trim($params['users']), TRUE);
    //Permissions always apply to the authenticated user, never to a requested one
    $current_user = $user->uid;
    $current_user_object = user_load($current_user);
    $bonita_id = gofast_workflows_get_user_id($current_user_object);
    $custom = is_array($params['custom']) ? $params['custom'] : json_decode(trim($params['custom']), TRUE);

    //Parse custom params
    $custom_parsed = array();
    foreach((array) $custom as $custom_element){
        $custom_element = explode('|', $custom_element);
        $custom_parsed[$custom_element[0]][] = $custom_element[1];
    }
    $process_instance_table_name = "bonita.process_instance";
    if($state != "progress"){
        $process_instance_table_name = "bonita.arch_process_instance";
    }

    $join_processcurrent = false;
    $join_processcurrent_contents = false;
    $join_contentcurrent = false;

    $query = db_select($process_instance_table_name, "pi")->distinct();
    $query->fields("pi", array("rootProcessInstanceId"));
    $query->condition("pi.name", $type, "=");
    $query->leftJoin("bonita.user_", "u_", "u_.id = pi.startedBy");
    //Exclude subprocesses
    $query->condition("pi.callerId", -1, "=");
    
    //Filter archived processes containing an end date only (really finished)
    if($state != "progress"){
        $query->condition("pi.endDate", 0, "!=");
    }
    //Filter by creator
    if(!empty($startedby)){
        $query->condition("pi.startedBy", $startedby, "=");
    }
    //Filter by type (of workflow)
    if(!empty($type) && $type != "all"){
        $query->condition("pi.name", $type, "=");
    }
    //Filter by title
    $title = trim($title);
    if(!empty($title)){
        if(!$join_processcurrent){
            $query->join("bonita_bdm.PROCESSCURRENT", "PC", "PC.PID = pi.rootProcessInstanceId");
            $join_processcurrent = true;
        }
        $query->condition("PC.TITLE", "%$title%", "LIKE");
    }
    //Filter by start date
    if(!empty($started)){
        $query->condition("pi.startDate", date("U", strtotime($started) * 1000), ">");
    }
    //Filter by deadline
    if(!empty($deadline)){
        if(!$join_processcurrent){
            $query->join("bonita_bdm.PROCESSCURRENT", "PC", "PC.PID = pi.rootProcessInstanceId");
            $join_processcurrent = true;
        }
        $query->condition("PC.END_DATE", $deadline, "<");
    }

    //Get Bonita search permissions
    $permissions = gofast_workflows_get_search_permissions();

    //Implements default permissions
    foreach(gofast_workflows_get_list_available_processes(false, false, $current_user) as $definition){
        if(!empty($type) && $type != "all" && $type != $definition['name']){
            //We are filtering on a single process so we won't implement other processes permissions
            continue;
        }
        if ($definition["name"] == "Document broadcast subprocess") {
            continue;
        }

        //Prepare / Reset variables
        $rule_action = "default";

        foreach($permissions as $permission){
          //Process name condition
          if($permission['type'] == "process_name"){
            //Check if our condition is matching the current process_name
            if(($permission['condition'] == $definition['name'] || $permission['condition'] == "*") && $definition['name'] != $permission['exclusion_condition']){
              $rule_action = $permission['action'];
            }
          }
        }
        if($rule_action == "deny"){
            //Don't display this process
            $query->condition("pi.name", $definition["name"], "!=");
        }else if($rule_action == "default"){
            //Display this process only if we created it or if we are being part of it
            $or = db_or();
            $or->condition("pi.name", $definition["name"], "!=");
            $or->condition("pi.startedBy", $bonita_id, "=");
            $query->condition($or);
            if(empty($documents) || empty($users) || empty($custom_parsed['contents'])){
                //Join process current and process current contents (!performance!)

                if(!$join_processcurrent){
                    $query->join("bonita_bdm.PROCESSCURRENT", "PC", "PC.PID = pi.rootProcessInstanceId");
                    $join_processcurrent = true;
                }
                if(!$join_processcurrent_contents){
                    $query->leftJoin("bonita_bdm.PROCESSCURRENT_CONTENTS", "PCC", "PCC.PROCESSCURRENT_PID = PC.persistenceId");
                    $join_processcurrent_contents = true;
                }
                if(!$join_contentcurrent){
                    $query->leftJoin("bonita_bdm.CONTENTCURRENT", "CC", "CC.persistenceId = PCC.CONTENTCURRENT_PID");
                    $join_contentcurrent = true;
                }

                //Check if we are part of the process
                $and = db_and();
                $and->condition("CC.NAME", "User", "=");
                $and->condition("CC.CONTENT_VALUE", "%$current_user_object->name%", "LIKE");
                $or->condition($and);
                $query->condition($or);
            }
        }
    }

    //Filter by documents or users
    if(!empty($documents) || !empty($users) || !empty($custom_parsed['contents'])){
        //Join process current and process current contents (!performance!)
        if(!$join_processcurrent){
            $query->join("bonita_bdm.PROCESSCURRENT", "PC", "PC.PID = pi.rootProcessInstanceId");
            $join_processcurrent = true;
        }
        if(!$join_processcurrent_contents){
            $query->leftJoin("bonita_bdm.PROCESSCURRENT_CONTENTS", "PCC", "PCC.PROCESSCURRENT_PID = PC.persistenceId");
            $join_processcurrent_contents = true;
        }
        if(!$join_contentcurrent){
            $query->leftJoin("bonita_bdm.CONTENTCURRENT", "CC", "CC.persistenceId = PCC.CONTENTCURRENT_PID");
            $join_contentcurrent = true;
        }

        //Implements permissions based on grouped BDM query
        $query->addExpression("GROUP_CONCAT(CC.NAME,CC.TYPE,TRIM(CC.CONTENT_VALUE))", "contents");

        //Start grouping now and filter after grouping and concat
        $query->groupBy("pi.rootProcessInstanceId");
        
        foreach($documents as $document){
            $query->havingCondition("contents", "%DocumentNode".trim($document)."%", "LIKE");
        }

        foreach($users as $bonita_user_id){
            $user_name = user_load(gofast_workflows_get_drupalid_from_bonitaid(trim($bonita_user_id)))->name;
            $query->havingCondition("contents", "%Useruser[\"$user_name\"%", "LIKE");
        }

        foreach($custom_parsed['contents'] as $custom_parsed_element){
            $query->havingCondition("contents", $custom_parsed_element, "LIKE");
        }
    }

    if(!empty($custom_parsed['title'])){
        foreach($custom_parsed['title'] as $custom_parsed_element){
            //Join process current and append the query
            if(!$join_processcurrent){
                $query->join("bonita_bdm.PROCESSCURRENT", "PC", "PC.PID = pi.rootProcessInstanceId");
                $join_processcurrent = true;
            }
            $query->condition("PC.TITLE", "%$custom_parsed_element%", "LIKE");
        }
    }

    //Sort: "<column> [ASC|DESC]", the column being a plain identifier (e.g. "bonita.user_.lastName DESC")
    if(!empty($custom_parsed['order'])){
        $order = explode(" ", trim($custom_parsed["order"][0]));
        $order_field = $order[0];
        $order_direction = strtoupper($order[1] ?? "ASC");
        $is_valid_field = preg_match("/^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*){0,2}$/", $order_field);
        if(count($order) > 2 || !$is_valid_field || !in_array($order_direction, array("ASC", "DESC"))){
            gofast_api_mandatory_parameter("A valid order");
        }
        $query->orderBy($order_field, $order_direction);
    }

    //Paginate the result
    $first_index = ($p*$c);

    $query->range($first_index, $c);

    $session_statements = array(
        "SET @@sql_mode=(SELECT REPLACE(@@sql_mode,'ONLY_FULL_GROUP_BY',''))",
        "SET SESSION group_concat_max_len = 15000",
    );
    $results = gofast_workflows_execute_bonita_select_query_bdm($query, $session_statements);
    $results = array_map(function($result) {
        return $result->rootProcessInstanceId;
    }, $results);
    return $results;
}

/*
 * Implements GoFAST API
 * Ressource : process
 * Action : filter_light_dashboard
 *
 * Filter processes to display in the light dashboard, used by LightDashboard page
 *
 */
function gofast_api_process_filter_light_dashboard($params){
    $output = array();

    //Check authentication
    global $user;
    if($user->uid == 0){
       gofast_api_not_authorized("Unavailable ressource for anonymous user");
    }

    //Check mathod
    if($params['method'] != "GET"){
        gofast_api_not_implemented("This method");
    }

    gofast_workflows_get_cookie();
    $cookie_name = "cookie_bonita".$user->name.".txt";
    $bonita_user_id = gofast_workflows_get_user_id($user);

    //Get tasks
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_HEADER, 0);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER,1);
    curl_setopt($ch, CURLOPT_POST, 0);
    curl_setopt($ch, CURLOPT_COOKIEFILE, "sites/default/files/swf/".$cookie_name);

    $url = URL_BONITA."API/bpm/humanTask" . "?p=0&c=99999&f=user_id=" . $bonita_user_id . "&o=dueDate";
    curl_setopt($ch, CURLOPT_URL, $url);
    $buf = gofast_workflows_curl_exec($ch);

    $buf = json_decode($buf);
    if(!empty($buf)){
        foreach($buf as $task){
            $output[] = $task;
        }
    }

    $userlists = gofast_userlist_get_userlists_by_user($user);
    $ulids = array_keys($userlists);
    $userlist_task_ids = gofast_workflows_get_userlist_tasks($ulids, FALSE, TRUE);
    $userlist_tasks = gofast_workflows_get_task_objects_from_db($userlist_task_ids);
    $output = [...$output, ...$userlist_tasks];

    gofast_api_success($output);
}

/*
 * Implements GoFAST API
 * Ressource : process
 * Action : filter_light_dashboard_other
 *
 * Filter processes to display in the light dashboard, used by LightDashboard page
 *
 */
function gofast_api_process_filter_light_dashboard_other($params){
    $output = array();

    //Check authentication
    global $user;
    if($user->uid == 0){
       gofast_api_not_authorized("Unavailable ressource for anonymous user");
    }

    //Check mathod
    if($params['method'] != "GET"){
        gofast_api_not_implemented("This method");
    }

    gofast_workflows_get_cookie();
    $cookie_name = "cookie_bonita".$user->name.".txt";
    $bonita_user_id = gofast_workflows_get_user_id($user);

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_HEADER, 0);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER,1);
    curl_setopt($ch, CURLOPT_POST, 0);
    curl_setopt($ch, CURLOPT_COOKIEFILE, "sites/default/files/swf/".$cookie_name);

    $url = URL_BONITA."API/extension/tasksAssignedOther" . "?p=0&c=99999" . "&uid=" . $bonita_user_id;
    curl_setopt($ch, CURLOPT_URL, $url);
    $buf = gofast_workflows_curl_exec($ch);
    $buf = json_decode($buf, TRUE);
    
    $output = [];
    if(!empty($buf)){
        foreach($buf['response']['content'] as $task){
            $output[] = $task;
        }
    }

    gofast_api_success($output);
}

function gofast_workflows_yousign_check_can_create_procedure(){
    print 0; exit;
}

function gofast_api_workflow_profil($params){
    switch($params['method']){
        case 'GET':
            gofast_api_get_workflow_profil($params);
          break;
        case 'PUT':
            gofast_api_put_workflow_profil($params);
          break;
        case 'PATCH':
            gofast_api_patch_workflow_profil($params);
          break;
        case 'DELETE':
            gofast_api_delete_workflow_profil($params);
          break;
        default:
            gofast_api_not_implemented("This method");
          break;
    }
}
function gofast_workflows_add_node_to_resync_oncron($nid){
    $resync_nodes=variable_get(BONITA_RESYNC_NEEDED_NODES_VARNAME,array());
    $resync_nodes[$nid]=$nid;
    variable_set(BONITA_RESYNC_NEEDED_NODES_VARNAME, $resync_nodes);
}

function gofast_workflows_is_external_api(){
  // Internal callers connect from the server itself; SERVER_NAME is the client Host header.
  return !in_array($_SERVER['REMOTE_ADDR'] ?? '', array('127.0.0.1', '::1'), TRUE);
}

/*
 * Implements GoFAST API
 * Give to the user it's Bonita token
 */
function gofast_api_workflows_token($params){
    //Check if we are authentified
    global $user;
    if($user->uid == 0){
        return gofast_api_not_authorized("No authentication method provided");
    }
    
    //Check method
    if($params['method'] != "GET"){
        gofast_api_not_implemented("This method");
    }
    
    //Check content type
    if(strpos($params['Content-Type'], "application/json") === FALSE){
        return gofast_api_not_implemented("This Content-Type");
    }
    
    $token = gofast_workflows_get_bonita_token();
    
    gofast_api_success(['token' => $token]);
}
/**
 *  Updates the user's bonita login details.
 */
function gofast_workflows_change_username($details): void {
  $new_username  = $details->new_username;
  $account       = $details->account;
  $old_username  = $details->old_username;
  $bonita_id     = gofast_workflows_get_user_id($account);
  $data          = array('userName' => $new_username);
  gofast_workflows_get_cookie(true);
  $cookie_name   = "cookie_bonita".BONITA_TECHNICAL_LOGIN.".txt";
  gofast_workflows_update_user($data,$bonita_id,$cookie_name);
  $query         = "update authmap set authname = '".$new_username."' where authname = '".$old_username."'";
  db_query($query);
}

/**
 * Implements hook_user_update()
 */
function gofast_workflows_user_update(&$edit, $account, $category) {
  // Check if firstname or lastname has been changed
  if ($account->original->ldap_user_givenname[LANGUAGE_NONE][0]['value'] != $account->ldap_user_givenname[LANGUAGE_NONE][0]['value'] || $account->original->ldap_user_sn[LANGUAGE_NONE][0]['value'] != $account->ldap_user_sn[LANGUAGE_NONE][0]['value'] ) {
        $bonita_id = gofast_workflows_get_user_id($account);   
        $data = gofast_workflows_prepare_firstname_lastname($account);
        gofast_workflows_get_cookie(true);
        $cookie_name = "cookie_bonita".BONITA_TECHNICAL_LOGIN.".txt";
        gofast_workflows_update_user($data,$bonita_id,$cookie_name);
  }
}

function gofast_workflows_prepare_firstname_lastname($account){
    if(mb_detect_encoding($account->ldap_user_givenname[LANGUAGE_NONE][0]['value'], 'UTF-8', true) != false){
        $encoded_firstname = utf8_encode($account->ldap_user_givenname[LANGUAGE_NONE][0]['value']);
    }else{
        $encoded_firstname = $account->ldap_user_givenname[LANGUAGE_NONE][0]['value'];
    } 
    if(mb_detect_encoding($account->ldap_user_sn[LANGUAGE_NONE][0]['value'], 'UTF-8', true) != false){
        $encoded_lastname = utf8_encode($account->ldap_user_sn[LANGUAGE_NONE][0]['value']);
    }else{
        $encoded_lastname = $account->ldap_user_sn[LANGUAGE_NONE][0]['value'];
    }
    $data = array("firstname" => $encoded_firstname ,"lastname" => $encoded_lastname);
    
    return $data;
}
