                $query->addField('vuo', 'og_nid', 'id');
                $query->condition('vuo.uid', $id, '=');
            break;

            case 'og':
                $query->addField('vuo', 'uid', 'id');
                $query->condition('vuo.og_nid', $id, '=');

            break;

        default:
            return [];
            break;
    }

    $result = $query->execute();
    $res = $result->fetchAll();

    foreach($res as $item) {
        $list[] = $item->id;
    }

    return $list;

}

