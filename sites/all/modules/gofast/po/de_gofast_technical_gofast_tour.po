#: sites/all/modules/gofast/js/gofast_tour.js
msgctxt "gofast_technical:gofast_tour"
msgid "text.tour.browser.ztree-nav-step"
msgstr ""
"<p>Ein Klick, um zum gewünschten <strong>Bereich</strong> oder "
"<strong>Verzeichnis </strong>zu gelangen.</p>\r\n"
"\r\n"
"<p><em><strong>Beachten Sie!</strong> Ein Verzeichnis ist für die "
"gleichen Benutzer zugänglich wie der übergeordnete Bereich, in dem "
"es sich befindet. Ein Bereich hat ein kleines spezielles Symbol, um "
"seine Art anzuzeigen (Persönlich, Gruppen, Organisationen, "
"Öffentlich, Extranet)</em></p>\r\n"
"\r\n"

