msgctxt "gofast_technical:gofast_tour"
msgid "text.tour.activity.first-step"
msgstr ""
"<p>Sehen Sie sich den <strong>Aktivitäts-Feed</strong> an, der alle "
"Inhalte (auf die Sie Zugriff haben) anzeigt, bei denen kürzlich "
"Aktionen durchgeführt wurden (Hinzufügen, Ändern, Kommentieren, "
"...)</p>\r\n"

