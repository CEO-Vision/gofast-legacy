msgid "title.tour.simplified-home.activity-step"
msgstr "Aktivitäten"

#: sites/all/modules/gofast/js/gofast_tour.js
msgctxt "gofast_technical:gofast_tour"
msgid "text.tour.simplified-home.activity-step"
msgstr ""
"Klicken Sie hier, um auf Ihren Aktivitäts-Feed zuzugreifen, der die "
"zuletzt geänderten, kommentierten, hinzugefügten Inhalte usw. enthält."

#: sites/all/modules/gofast/js/gofast_tour.js
msgctxt "gofast_technical:gofast_tour"
msgid "title.tour.simplified-home.filebrowser-step"
msgstr "Dateiexplorer"

#: sites/all/modules/gofast/js/gofast_tour.js
msgctxt "gofast_technical:gofast_tour"
msgid "text.tour.simplified-home.filebrowser-step"
msgstr ""
"<p>Klicken Sie hier, um auf Ihre verschiedenen Bereiche zuzugreifen, "
"einschließlich:</p>\r\n"
"\r\n"
"<ul>\r\n"
"\t<li>Ihres <strong>Persönlichen Bereichs</strong> (nur für Sie "
"zugänglich),</li>\r\n"
"\t<li>der <strong>Gruppen</strong> (nur für deren Mitglieder "
"zugänglich),</li>\r\n"
"\t<li>der <strong>Organisationen </strong>(das Organigramm Ihrer "
"Struktur) und</li>\r\n"
"\t<li>der <strong>Öffentlichen Bereiche</strong> (für alle Benutzer "
"außer \"Externe\" zugänglich) und</li>\r\n"
"\t<li>der <strong>Extranet-Bereiche</strong> (Freigaben mit Externen)</li>\r\n"
"</ul>"

#: sites/all/modules/gofast/js/gofast_tour.js
msgctxt "gofast_technical:gofast_tour"
msgid "title.tour.activity.first-step"
msgstr "Aktivitäts-Feed"

