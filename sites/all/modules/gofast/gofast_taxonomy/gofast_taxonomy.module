function gofast_taxonomy_tag_edit($js = FALSE, $term = new stdClass()) {
  $new_name = gofast_xss_clean($_POST["name"]);
  $term->name = $new_name;
  taxonomy_term_save($term);
  if ($js) {
    drupal_json_output($term);
    exit();
  }
  return $term;
}

/**
 * Small helper to add term only if it doesn't exist yet
 * @param type $vid
 * @param type $name
 * @return mixed $term
 */
function gofast_taxonomy_get_or_add_term($vid, $name) {
  $vname = gofast_get_vocab_machine_name($vid);
  // Check if entity exists in taxonomy
  $term = reset(taxonomy_get_term_by_name($name, $vname));
  // If not create it
  if (!$term) {
    $term = gofast_taxonomy_vocabulary_add_term($vid, $name);
  }
  return $term;
}

/**
 * Helper to programatically add a term to an existing vocabulary.
 * @param type $vid
 * @param type $name
 */
function gofast_taxonomy_vocabulary_add_term($vid, $name) {
  // IF TERM IS NOT FOUND : taxonomy_term_load_multiple(array(), array('name' => trim($name), 'vid' => $vid));
  $term = new stdClass();
  $term->name = gofast_xss_clean($name);
  $term->vid = $vid;
  taxonomy_term_save($term);
  return $term;
}

